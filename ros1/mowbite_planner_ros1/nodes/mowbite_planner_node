def call(methods, method, params):
    """mowbite_planner.core's call, in rospy's log."""
    return core.call(methods, method, params, rospy.loginfo, rospy.logerr)


class XbotRpc:
    """OpenMower's RPC methods from Python, like xbot_mqtt's RpcProvider: xbot_monitoring hands the requests
    for registered methods to /xbot/rpc/request, the answers go back on /xbot/rpc/response or /xbot/rpc/error.
    methods: name -> callback(params) giving the result, a PlanningError is the caller's mistake."""

    def __init__(self, node_id, methods):
        self.node_id, self.methods = node_id, methods
        self.response = rospy.Publisher('/xbot/rpc/response', RpcResponse, queue_size=100)
        self.error = rospy.Publisher('/xbot/rpc/error', RpcError, queue_size=100)
        self.register = rospy.ServiceProxy('/xbot/rpc/register', RegisterMethodsSrv)
        rospy.Subscriber('/xbot/rpc/request', RpcRequest, self.on_request, queue_size=100, tcp_nodelay=True)
        # latched by xbot_monitoring when it starts: it forgot the methods, register them again
        rospy.Subscriber('/xbot/rpc/registry', Empty, lambda _: self.publish_methods())
        threading.Thread(target=self.publish_methods, daemon=True).start()

    def publish_methods(self):
        try:
            rospy.wait_for_service('/xbot/rpc/register', timeout=30.0)
            self.register(self.node_id, sorted(self.methods))
        except (rospy.ROSException, rospy.ServiceException) as e:  # RPCs aren't needed for mowing
            rospy.logwarn('MowBite Planner: RPC methods not registered: %s', e)

    def on_request(self, req):
        if req.method not in self.methods:  # another node's
            return
        if req.method in BACKGROUND:
            threading.Thread(target=self.answer, args=(req,), name='rpc %s' % req.method, daemon=True).start()
        else:
            self.answer(req)

    def answer(self, req):
        try:
            params = json.loads(req.params) if req.params else None
        except ValueError:
            params = []
        REQUEST.id = req.id
        result, error = call(self.methods, req.method, params)
        if error is None and too_big(result):  # (over MQTT: the broker would drop it without a word)
            error = (ANSWER_TOO_BIG, too_big(result))
            rospy.logwarn('MowBite Planner: %s: %s', req.method, error[1])
        if error is not None:
            return self.fail(req, *error)
        if req.id:
            self.response.publish(RpcResponse(result=result, id=req.id))

    def fail(self, req, code, message):
        if req.id:
            self.error.publish(RpcError(code=code, message=message, id=req.id))


class WebPage:
    """The settings page with a preview of the plans, http://<mower>:<port>/ without the MowBite app: GET / the page
    (WEB_DIR's index.html), GET /map the node's map (null before there is one), POST /rpc {method, params} a method
    of methods like over MQTT, answered {result} or {error: {code, message}}. Only JSON is taken (another web page
    can't send it without asking first). No login: anyone on the network may change the settings, like over MQTT."""

    def __init__(self, port, methods, the_map):
        page = self

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                page.get(self)

            def do_POST(self):
                page.post(self)

            def log_message(self, *args):
                pass

        self.methods, self.the_map = methods, the_map
        self.server = http.server.ThreadingHTTPServer(('', port), Handler)
        self.server.daemon_threads = True
        threading.Thread(target=self.server.serve_forever, name='web page', daemon=True).start()

    @staticmethod
    def send(req, code, body, kind):
        req.send_response(code)
        req.send_header('Content-Type', kind)
        req.send_header('Content-Length', str(len(body)))
        req.send_header('Cache-Control', 'no-store')
        req.end_headers()
        req.wfile.write(body)

    def get(self, req):
        path = req.path.split('?', 1)[0]
        if path in ('/', '/index.html'):
            try:
                with open(os.path.join(WEB_DIR, 'index.html'), 'rb') as f:
                    return self.send(req, 200, f.read(), 'text/html; charset=utf-8')
            except OSError as e:
                return self.send(req, 500, ('no page: %s' % e).encode(), 'text/plain; charset=utf-8')
        if path == '/map':
            return self.send(req, 200, json.dumps(self.the_map()).encode(), 'application/json')
        self.send(req, 404, b'not found', 'text/plain')

    def post(self, req):
        if req.path.split('?', 1)[0] != '/rpc':
            return self.send(req, 404, b'not found', 'text/plain')
        if req.headers.get('Content-Type', '').split(';')[0].strip() != 'application/json':
            return self.send(req, 415, b'JSON only', 'text/plain')
        try:
            length = int(req.headers.get('Content-Length') or 0)
        except ValueError:
            length = -1
        if not 0 <= length <= WEB_MAX_REQUEST:
            return self.send(req, 413, b'too big', 'text/plain')
        try:
            body = json.loads(req.rfile.read(length) or b'null')
        except ValueError:
            body = None
        method = body.get('method') if isinstance(body, dict) else None
        if not isinstance(method, str) or method not in self.methods:
            result, error = None, (METHOD_NOT_FOUND, 'Method "%s" not found' % method)
        else:
            result, error = call(self.methods, method, body.get('params'))
        out = '{"result": %s}' % result if error is None else json.dumps({'error': {'code': error[0],
                                                                                     'message': error[1]}})
        self.send(req, 200, out.encode(), 'application/json')


class Calibration:
    """planner.calib.* (OpenMower's way to the calibration, mowbite_planner.calib): start records OpenMower's GNSS,
    IMU, odometry (the measured twist, the ESCs' tacho as ticks where they send it: calibrecord.Tacho) and cmd_vel
    (calibrecord.Recorder into folder, the one before gone) once it can (each topic there,
    RTK fixed but for a mow, disk space: check says it beforehand), stop ends it. It ends by itself at its time or
    size limit, after a mow in mode mow (JOB_COMPLETE), and with enough data: once the runs and turns counted while it's recorded are enough, it's
    evaluated as it stands every CALIB_CHECK s until that's ready. Then it's evaluated (run_calib: a process of its
    own) into folder/result.json, result answers with it. A recording found without its result (the node restarted)
    is evaluated as the node starts, without its end line up to there (said so). Not in the worker: it never looks
    at a plan's shapes.
    Only what's driven with RTK fixed counts (calibrecord.Counts): a mow may be begun without it (in the dock), rtk in
    the progress says it's waiting for it.
    How far it got goes to CALIB_TOPIC (retained, at most every CALIB_EVERY s): {phase (recording, evaluating, done),
    m, turns, runs (as counted while recording, then the evaluation's), still_s, turns_left, turns_right,
    rotation_left, rotation_right, tight_left, tight_right (as counted while recording, calibrecord.Counts.progress),
    mode (joystick or mow, the recording's) and need (what the mode needs by those names and run_m,
    calibrecord.needed: it ends by itself once all are there), both from the start on, ready (enough data: the
    evaluation's), error (why it ended without a result), rtk ({fixed, accuracy} as planner.calib.check's, the last
    GNSS message, while it's recorded)}."""

    def __init__(self, folder, publish, software):
        self.recorder = calibrecord.Recorder(folder)
        self.publish, self.software = publish, software
        self.lock = threading.Lock()
        self.subs = []
        self.phase, self.error, self.ready, self.based_on, self.sent = None, None, False, None, 0.0
        self.checked, self.checking, self.enough = 0.0, False, False
        self.gps = None  # (the last GNSS message while it's recorded)
        self.tacho, self.tacho_lock = None, threading.Lock()
        self.wake = threading.Event()  # (the recording's steps end at once with it)
        if os.path.exists(self.recorder.path) and not os.path.exists(self.recorder.result):
            rospy.loginfo('MowBite Planner: the calibration recorded before the node started is evaluated')
            self.phase = 'evaluating'
            threading.Thread(target=self.evaluate, args=(True,), name='calibration evaluation', daemon=True).start()

    @staticmethod
    def rtk(msg):
        """{fixed (RTK fixed as the evaluation takes it), accuracy} of a GNSS message, None without one."""
        if msg is None:
            return None
        fixed = 'fixed' if msg.flags & AbsolutePose.FLAG_GPS_RTK_FIXED else 'float'
        return {'fixed': calibrecord.fixed(fixed, msg.position_accuracy),
                'accuracy': round(float(msg.position_accuracy), 4)}

    def look(self):
        """([{reason, message}], {name: the message on its topic, None: none}, the parameters' values): what stands
        in the way of a recording."""
        problems, msgs, old = [], {}, {}
        if self.phase == 'evaluating':
            problems.append(('BUSY', 'the last calibration is being evaluated'))
        elif self.recorder.recording:
            problems.append(('BUSY', 'a calibration is recorded already'))
        for name, topic, kind in (('gps', CALIB_GPS, AbsolutePose), ('imu', CALIB_IMU, Imu),
                                  ('twist', CALIB_TWIST, TwistStamped)):
            try:
                msgs[name] = rospy.wait_for_message(topic, kind, timeout=CALIB_WAIT)
            except rospy.ROSException:
                msgs[name] = None
                problems.append(('SENSOR_MISSING', 'nothing on %s' % topic))
            if name == 'gps' and msgs[name] is not None:
                if not msgs[name].flags & AbsolutePose.FLAG_GPS_RTK_FIXED:
                    problems.append(('NO_RTK', 'no RTK fixed'))
                elif not self.rtk(msgs[name])['fixed']:
                    problems.append(('POSITION_ACCURACY', 'RTK fixed, but %.3f m accuracy (%.2f m at most)' % (
                        msgs[name].position_accuracy, calibrecord.RTK_ACC)))
        for name, key in CALIB_PARAMS.items():
            value = rospy.get_param(key, None)
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                problems.append(('PARAM_MISSING', 'OpenMower\'s parameter %s isn\'t set' % key))
            else:
                old[name] = float(value)
        folder = self.recorder.folder
        while not os.path.isdir(folder) and os.path.dirname(folder) != folder:
            folder = os.path.dirname(folder)
        free = shutil.disk_usage(folder).free
        if free < calibrecord.FREE:
            problems.append(('DISK_SPACE', 'only %d MB free on the mower, %d MB needed' % (
                free >> 20, calibrecord.FREE >> 20)))
        return [{'reason': r, 'message': m} for r, m in problems], msgs, old

    def rpc_check(self, params):
        problems, msgs, _ = self.look()
        return {'ok': not problems, 'problems': problems, 'rtk': self.rtk(msgs['gps'])}

    def rpc_start(self, params):
        mode = params.get('mode')
        if mode not in calibrecord.LIMIT_S:
            raise PlanningError('mode must be one of %s' % ', '.join(sorted(calibrecord.LIMIT_S)))
        with self.lock:
            problems, msgs, old = self.look()
            # (a mow begun in the dock: it counts once there's RTK fixed)
            stops = [p for p in problems if mode != 'mow' or p['reason'] not in ('NO_RTK', 'POSITION_ACCURACY')]
            if stops:
                raise PlanningError(stops[0]['message'])
            imu = msgs['imu']
            try:
                self.recorder.start(mode, old, imu.header.frame_id or None, self.software, time.time())
            except calibrecord.Refused as e:
                raise PlanningError(str(e))
            except OSError as e:
                raise PlanningError('not recorded: %s' % e)
            self.phase, self.error, self.ready, self.based_on, self.gps = 'recording', None, False, None, msgs['gps']
            self.checked, self.enough, self.wake = time.time(), False, threading.Event()
            self.tacho = calibrecord.Tacho()
            self.subs = [rospy.Subscriber(CALIB_GPS, AbsolutePose, self.on_gps, queue_size=50),
                         rospy.Subscriber(CALIB_IMU, Imu, self.on_imu, queue_size=200),
                         rospy.Subscriber(CALIB_TWIST, TwistStamped, self.on_twist, queue_size=50),
                         rospy.Subscriber(CALIB_CMD, Twist, self.on_cmd, queue_size=50)] + [
                rospy.Subscriber(topic, ESCStatus, lambda msg, side=side: self.on_esc(side, msg), queue_size=50)
                for side, topic in CALIB_ESC.items()]
            threading.Thread(target=self.loop, args=(self.wake,), name='calibration recording', daemon=True).start()
        rospy.loginfo('MowBite Planner: recording a calibration (%s)', mode)
        self.send(at_once=True)
        return {'ok': True}

    def rpc_stop(self, params):
        if not self.recorder.recording:
            raise PlanningError('no calibration is recorded')
        self.finish('stop')
        return {'ok': True}

    def rpc_result(self, params):
        if self.recorder.recording:
            raise PlanningError('the calibration is still recorded')
        if self.phase == 'evaluating':
            raise PlanningError('the calibration is being evaluated')
        try:
            with open(self.recorder.result) as f:
                return json.load(f)
        except (OSError, ValueError):
            raise PlanningError(self.error or 'no calibration recorded')

    def job_complete(self):
        """A mow finished: in mode mow that ends the recording."""
        if self.recorder.recording and self.recorder.mode == 'mow':
            self.finish('stop')

    def on_gps(self, msg):
        self.gps = msg
        p, motion = msg.pose.pose.position, bool(msg.motion_vector_valid)
        fix = 'fixed' if msg.flags & AbsolutePose.FLAG_GPS_RTK_FIXED else \
            'float' if msg.flags & AbsolutePose.FLAG_GPS_RTK_FLOAT else 'single'
        self.recorder.add('gps', time.time(), x=float(p.x), y=float(p.y), z=float(p.z),
                          acc=float(msg.position_accuracy), fix=fix,
                          vh=float(msg.vehicle_heading) if msg.orientation_valid else None,
                          mh=float(msg.motion_heading) if motion else None,
                          ve=float(msg.motion_vector.x) if motion else None,
                          vn=float(msg.motion_vector.y) if motion else None)

    def on_imu(self, msg):
        g, a = msg.angular_velocity, msg.linear_acceleration
        self.recorder.add('imu', time.time(), gx=float(g.x), gy=float(g.y), gz=float(g.z), ax=float(a.x),
                          ay=float(a.y), az=float(a.z))

    def on_twist(self, msg):
        self.recorder.add('twist', time.time(), v=float(msg.twist.linear.x), w=float(msg.twist.angular.z))

    def on_esc(self, side, msg):
        with self.tacho_lock:
            pair = self.tacho.add(side, msg.tacho)
        if pair is not None:
            self.recorder.add('ticks', time.time(), l=pair[0], r=pair[1])

    def on_cmd(self, msg):
        self.recorder.add('cmd', time.time(), v=float(msg.linear.x), w=float(msg.angular.z))

    def loop(self, wake):
        while self.recorder.recording and not wake.wait(CALIB_TICK):
            self.step(time.time())

    def step(self, now):
        """What came written; it ends where it has to, or is evaluated as it stands where it may be enough."""
        ended = self.recorder.tick(now)
        if ended is not None:
            self.finish(*ended)
        elif self.enough:
            self.finish('enough')
        elif self.recorder.recording:
            counts = self.recorder.counts
            if counts.enough() and not self.checking and now - self.checked >= CALIB_CHECK[self.recorder.mode]:
                self.checking = True
                threading.Thread(target=self.check, args=(self.recorder.started,), name='calibration check',
                                 daemon=True).start()
            self.send()

    def check(self, started):
        """The recording begun at started evaluated as it stands: ready, it ends (with the next step). (Ended
        meanwhile, or another begun: nothing.)"""
        try:
            self.recorder.flush()
            ready = bool(run_calib(self.recorder.path, interim=True).get('ready'))
            with self.lock:
                if self.recorder.recording and self.recorder.started == started:
                    self.ready = self.enough = ready
        finally:
            self.checked, self.checking = time.time(), False

    def finish(self, why, reason=None):
        with self.lock:
            if not self.recorder.recording:
                return
            for sub in self.subs:
                sub.unregister()
            self.subs = []
            failed = self.recorder.end(why, time.time(), reason)
            self.phase = 'evaluating'
            self.wake.set()
        if failed:
            rospy.logwarn('MowBite Planner: the calibration\'s recording not ended well: %s', failed)
        rospy.loginfo('MowBite Planner: calibration recorded (%s%s), evaluating it', why,
                      ': ' + reason if reason else '')
        threading.Thread(target=self.evaluate, name='calibration evaluation', daemon=True).start()

    def evaluate(self, cut=False):
        self.send(at_once=True)
        result = run_calib(self.recorder.path, cut=cut)
        error = result.get('error', 'the evaluation gave no values') if 'values' not in result else None
        if error is None:
            try:
                temp = self.recorder.result + '.tmp'
                with open(temp, 'w') as f:
                    json.dump(result, f)
                os.replace(temp, self.recorder.result)
            except OSError as e:
                error = 'the result not kept: %s' % e
        with self.lock:
            self.phase, self.error = 'done', error
            self.ready, self.based_on = (bool(result.get('ready')), result.get('based_on')) if error is None else \
                (False, None)
        if error:
            rospy.logwarn('MowBite Planner: calibration not evaluated: %s', error)
        else:
            rospy.loginfo('MowBite Planner: calibration evaluated, %s', ', '.join(
                '%s %s' % (v['name'], v['value'] if v['ok'] else '-') for v in result['values']))
        self.send(at_once=True)

    def send(self, at_once=False):
        now = time.time()
        if not at_once and now - self.sent < CALIB_EVERY:
            return
        self.sent = now
        counts = self.recorder.counts.progress() if self.recorder.counts else {'m': 0.0, 'turns': 0.0, 'runs': 0}
        message = dict(counts, **(self.based_on or {}), phase=self.phase, ready=self.ready, error=self.error)
        if self.recorder.mode is not None:
            message['mode'], message['need'] = self.recorder.mode, calibrecord.needed(self.recorder.mode)
        if self.recorder.recording:
            message['rtk'] = self.rtk(self.gps)
        try:
            self.publish(json.dumps(message))
        except Exception as e:  # noqa: BLE001 - showing progress must not take the recording down
            rospy.logwarn('MowBite Planner: calibration progress not published: %s', e)


class HoldReader:
    """The MowBite Updater's hold of the starts (HOLD_TOPIC, retained, {"until": unix s}, none or empty: no hold) while
    it restarts OpenMower or the planner. held() says why the mower may not be sent out: a hold whose end is still to
    come and at most HOLD_MAX s away, and when it can't tell (no paho-mqtt, no connection to the broker, subscribed
    less than HOLD_SETTLE s ago, a payload it can't read). paho-mqtt connects again by itself."""

    def __init__(self, client=None):
        self.lock = threading.Lock()
        self.why = 'not connected yet'  # held without a hold: why, '' when subscribed
        self.subscribed = 0.0  # when the broker took the subscription
        self.payload = None  # of the last message since, None: none
        if client is None:
            try:
                import paho.mqtt.client as mqtt
            except ImportError:
                self.why = 'no paho-mqtt'
                rospy.logerr('MowBite Planner: no paho-mqtt, leftovers_auto never sends the mower out')
                return
            client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
        self.client = client
        client.on_connect = self.on_connect
        client.on_disconnect = self.on_disconnect
        client.on_subscribe = self.on_subscribe
        client.on_message = self.on_message
        client.reconnect_delay_set(1, 10)
        client.connect_async(*HOLD_BROKER)
        client.loop_start()

    def on_connect(self, client, userdata, flags, reason_code, properties=None):
        if reason_code.is_failure:
            with self.lock:
                self.why = 'connection refused (%s)' % reason_code
            return
        with self.lock:
            self.why = 'not subscribed yet'
            self.payload = None
        client.subscribe(HOLD_TOPIC, 1)

    def on_disconnect(self, client, userdata, flags, reason_code, properties=None):
        with self.lock:
            self.why = 'no connection to %s:%d' % HOLD_BROKER

    def on_subscribe(self, client, userdata, mid, reason_codes, properties=None):
        with self.lock:
            if any(c.is_failure for c in reason_codes):
                self.why = 'subscription refused (%s)' % ', '.join(str(c) for c in reason_codes)
            else:
                self.why, self.subscribed = '', time.time()

    def on_message(self, client, userdata, msg):
        with self.lock:
            self.payload = bytes(msg.payload)

    def held(self, now=None):
        """Why the mower may not be sent out now, '' when it may."""
        now = time.time() if now is None else now
        with self.lock:
            why, subscribed, payload = self.why, self.subscribed, self.payload
        if why:
            return why
        if payload is None:
            return 'no answer from the broker yet' if now < subscribed + HOLD_SETTLE else ''
        if not payload:
            return ''
        try:
            until = json.loads(payload.decode())['until']
            if isinstance(until, bool) or not isinstance(until, (int, float)) or not math.isfinite(until):
                raise ValueError
        except (ValueError, KeyError, TypeError):  # (UnicodeDecodeError is a ValueError)
            return 'unreadable %s: %r' % (HOLD_TOPIC, payload[:100])
        if now < until <= now + HOLD_MAX:
            return 'held by the MowBite Updater until %s' % time.strftime('%H:%M:%S', time.localtime(until))
        return ''


class RemotePlanning:
    """remote_planning: plans asked of a computer in the house (mowbite_planner.house there) over the mower's own
    broker (REMOTE_BROKER, like HoldReader; paho-mqtt connects again by itself), its topics under remote.TOPIC. The
    house's hello (retained, every remote.HELLO_EVERY s: its code, stack, arch) says whether it's there and plans as
    here; want (retained) tells it what runs here (code, stack): its watcher fetches that code. ask() sends a request
    and waits for its answer, a header and the plan packed in parts. Only what comes for the request waiting is taken
    (with its key and the code of here), everything else is dropped."""

    def __init__(self, code, client=None):
        self.code, self.stack = code, stack()
        self.cond = threading.Condition()
        self.why = 'not connected yet'  # why there's no house, '' when connected
        self.hello, self.heard = None, 0.0  # the house's last hello and when it was sent (time.monotonic())
        self.open = None  # the request waiting (ask)
        self.quiet = 0.0  # (time.monotonic()) it isn't asked till then: it didn't answer
        self.started, self.connected = time.monotonic(), 0.0
        self.client = None
        if client is None:
            try:
                import paho.mqtt.client as mqtt
            except ImportError:
                self.why = 'no paho-mqtt'
                return
            client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
        self.client = client
        client.on_connect = self.on_connect
        client.on_disconnect = self.on_disconnect
        client.on_message = self.on_message
        client.reconnect_delay_set(1, 10)
        client.connect_async(*REMOTE_BROKER)
        client.loop_start()

    def on_connect(self, client, userdata, flags, reason_code, properties=None):
        if reason_code.is_failure:
            with self.cond:
                self.why = 'connection refused (%s)' % reason_code
            return
        with self.cond:
            self.why, self.hello, self.connected = '', None, time.monotonic()  # (the retained hello comes again)
        client.subscribe([(TOPIC + topic, 1) for topic in ('hello', 'progress/+', 'answer/+', 'answer/+/+')])
        client.publish(TOPIC + 'want', json.dumps({'code': self.code, 'stack': self.stack}), qos=1, retain=True)

    def on_disconnect(self, client, userdata, flags, reason_code, properties=None):
        with self.cond:
            self.why, self.hello = 'no connection to %s:%d' % REMOTE_BROKER, None
            self.cond.notify_all()

    def on_message(self, client, userdata, msg):
        if not msg.topic.startswith(TOPIC):
            return
        topic, payload = msg.topic[len(TOPIC):], bytes(msg.payload)
        if topic == 'hello':
            self.on_hello(payload, bool(getattr(msg, 'retain', False)))
            return
        kind, _, rest = topic.partition('/')
        rid, _, part = rest.partition('/')
        step = None
        with self.cond:
            asked = self.open
            if asked is None or rid != asked['id'] or kind not in ('progress', 'answer'):
                return  # (another's, or one given up)
            try:
                if kind == 'progress':
                    step = self.progress_of(payload)
                elif part:
                    self.part_of(asked, part, payload)
                elif asked['answer'] is None:
                    asked['answer'] = self.answer_of(asked, payload)
            except RemoteError:
                return  # (not the house's: no word from it)
            asked['heard'] = time.monotonic()
            self.cond.notify_all()
        if step is not None:
            asked['step'](*step)

    def on_hello(self, payload, retained):
        """The house's hello: {code, stack, arch, at (unix s it was sent)}, empty: gone. A retained one counts as sent
        when it says (where that's no more than REMOTE_FRESH s ago here), another as sent now."""
        hello = None
        try:
            if payload:
                hello = loads(payload) if len(payload) <= REMOTE_SMALL else None
                if not isinstance(hello, dict) or not isinstance(hello.get('code'), str) or \
                        not isinstance(hello.get('stack'), dict) or not isinstance(hello.get('at'), (int, float)):
                    raise RemoteError('not a hello')
        except RemoteError as e:
            rospy.logwarn_throttle(600, 'MowBite Planner: the house computer\'s hello not taken: %s' % e)
            hello = None
        with self.cond:
            self.hello = hello
            age = max(0.0, time.time() - hello['at']) if hello is not None and retained else 0.0
            self.heard = time.monotonic() - min(age, 2.0 * REMOTE_FRESH)
            self.cond.notify_all()

    @staticmethod
    def progress_of(payload):
        got = loads(payload) if len(payload) <= REMOTE_SMALL else None
        if not isinstance(got, dict) or not isinstance(got.get('stage'), str) or len(got['stage']) > 32 or \
                not all(isinstance(got.get(n), int) and not isinstance(got[n], bool) for n in ('done', 'of')):
            raise RemoteError('progress not readable')
        return got['stage'], max(0, got['done']), max(1, got['of'])

    def answer_of(self, asked, payload):
        """The answer's header: {id, key, code, ok, parts, bytes, sha256} or {..., ok: false, error, refused}."""
        got = loads(payload) if len(payload) <= REMOTE_SMALL else None
        if not isinstance(got, dict) or got.get('key') != asked['key'] or got.get('code') != self.code:
            raise RemoteError('not for this request')
        if got.get('ok') is not True:
            error = got.get('error')
            return {'error': error[:500] if isinstance(error, str) else 'no plan',
                    'refused': got.get('refused') is True and isinstance(error, str)}
        parts, size, digest = got.get('parts'), got.get('bytes'), got.get('sha256')
        if not (isinstance(parts, int) and isinstance(size, int) and isinstance(digest, str)) or \
                not 0 < parts <= MAX_PACKED // PART + 1 or not 0 < size <= MAX_PACKED or len(digest) != 64:
            raise RemoteError('header not readable')
        return {'parts': parts, 'bytes': size, 'sha256': digest}

    @staticmethod
    def part_of(asked, part, payload):
        if not part.isdigit() or len(part) > 3 or int(part) > MAX_PACKED // PART or len(payload) > PART:
            raise RemoteError('a part that isn\'t one')
        asked['parts'][int(part)] = payload

    def state(self):
        """(why the house isn't asked now, '' where it is; planner.settings' block remote: {reachable, arch,
        code_match, stack_match, why})."""
        with self.cond:
            why, hello, heard = self.why, self.hello, self.heard
        reachable = not why and hello is not None and time.monotonic() - heard <= REMOTE_FRESH
        code_match = reachable and hello['code'] == self.code
        stack_match = reachable and hello['stack'] == self.stack
        why = '' if code_match and stack_match else 'house computer out of date' if reachable else 'no house computer'
        return why, {'reachable': reachable, 'arch': hello.get('arch') if reachable else None,
                     'code_match': code_match, 'stack_match': stack_match, 'why': why or None}

    def ready(self):
        """Why the house isn't asked now ('' where it is): state's, or it didn't answer a while ago. It waits
        REMOTE_SETTLE s after connecting for the retained hello, and within REMOTE_CATCH_UP s of the start for a house
        on the same stack but another code: its watcher fetches the code of here (a planner update)."""
        while True:
            why, house = self.state()
            with self.cond:
                now = time.monotonic()
                if not why:
                    return '' if now >= self.quiet else 'it didn\'t answer, asked again from %s' % time.strftime(
                        '%H:%M', time.localtime(time.time() + self.quiet - now))
                fetching = house['stack_match'] and now < self.started + REMOTE_CATCH_UP
                if not (fetching or self.connected and now < self.connected + REMOTE_SETTLE):
                    return why
                self.cond.wait(1.0)

    def ask(self, key, form, wait, step):
        """The house's plan for the request with key (remote.request_json's form): (the plan packed, '') or (None, why
        not: no word from the house for REMOTE_STALL s, none within wait s, its answer). step(stage, done, of): the
        house's progress. PlanningError: the planner's no to it there."""
        rid = uuid.uuid4().hex
        try:
            payload = json.dumps({'id': rid, 'key': key, 'code': self.code, 'stack': self.stack, 'wait_s': wait,
                                  'form': form}, allow_nan=False, separators=(',', ':'))
        except ValueError:
            return None, 'a number in the request isn\'t finite'
        if len(payload) > MAX_ANSWER:
            return None, 'the request is too big to send'
        began = time.monotonic()
        with self.cond:
            self.open = {'id': rid, 'key': key, 'heard': began, 'answer': None, 'parts': {}, 'step': step}
        try:
            self.client.publish(TOPIC + 'request', payload, qos=1)
            with self.cond:
                while True:
                    got = self.answered(self.open)
                    if got is not None:
                        return got
                    now = time.monotonic()
                    stalled, late = now - self.open['heard'] > REMOTE_STALL, now - began > wait
                    if stalled or late or self.why:
                        if not self.why:
                            self.quiet = now + REMOTE_QUIET
                        return None, self.why or ('no word from it for %.0f s' % REMOTE_STALL if stalled else
                                                  'no plan from it within %.0f s' % wait)
                    self.cond.wait(1.0)
        finally:
            with self.cond:
                self.open = None

    @staticmethod
    def answered(asked):
        """(the plan packed, '') or (None, why not) once the answer's in, None till then. PlanningError: the
        planner's no."""
        answer = asked['answer']
        if answer is None:
            return None
        if 'error' in answer:
            if answer.get('refused'):
                raise PlanningError(answer['error'])
            return None, answer['error']
        if any(k not in asked['parts'] for k in range(answer['parts'])):
            return None if len(asked['parts']) <= answer['parts'] else (None, 'more parts than it said')
        data = b''.join(asked['parts'][k] for k in range(answer['parts']))
        if len(data) != answer['bytes'] or hashlib.sha256(data).hexdigest() != answer['sha256']:
            return None, 'its answer is broken'
        return data, ''


class MowbitePlannerRos1(PlannerCore):
    """mowbite_planner.core's PlannerCore on OpenMower (see the top): rospy, xbot_mqtt's RPCs and MQTT,
    mower_logic's plan_path, its parameters and events, the slic3r planner, planner.simulate, planner.calib.*, the
    house computer and the MowBite Updater's hold."""

    def __init__(self):
        # (after rospy.init_node: it sets up rosout's handlers anew)
        logging.getLogger('rosout').addHandler(LOG)
        self.mqtt = rospy.Publisher('/xbot_monitoring/mqtt_publish', MqttPublish, queue_size=10)
        ros_home = os.environ.get('ROS_HOME', '~/.ros')
        PlannerCore.__init__(
            self, float(rospy.get_param('~mower_width', 0.18)), dict(rospy.get_param('~settings', {}) or {}),
            os.path.expanduser(rospy.get_param('~settings_file', os.path.join(ros_home,
                                                                              'mowbite_planner_settings.json'))),
            os.path.expanduser(rospy.get_param('~plans_dir', os.path.join(ros_home, 'mowbite_plans'))),
            os.path.expanduser(rospy.get_param('~history_dir', os.path.join(ros_home, core.HISTORY_DIR))),
            rospy.get_param('~workers', 0))
        # OpenMower's FTC controller needs 3 poses a path, pieces of at most 3 can't always have them
        self.max_poses = max(4, int(rospy.get_param('~max_path_poses', MAX_PATH_POSES)))
        self.frame_id = rospy.get_param('~frame_id', 'map')
        # remote_planning: the house computer, why the last plan wasn't planned there (in the log once)
        self.remote = RemotePlanning(self.code) if rospy.get_param('~remote', REMOTE) else None
        self.remote_said = ''
        # planner.calib.*: the recording and its result in calib_dir
        self.calib = Calibration(os.path.expanduser(rospy.get_param('~calib_dir', os.path.join(
            ros_home, 'mowbite_calib'))), lambda payload: self.publish(CALIB_TOPIC, payload, True), self.code)
        if rospy.get_param('~use_map', True):
            rospy.Subscriber(rospy.get_param('~map_topic', '/mower_map_service/json_map'), String, self.on_map)
        rospy.Subscriber('/xbot_monitoring/mqtt_publish', MqttPublish, self.on_publish)
        self.action = rospy.Publisher(ACTION_TOPIC, String, queue_size=1)
        self.hold = HoldReader() if rospy.get_param('~hold', HOLD) else None
        self.classic_name = rospy.get_param('~classic_service', CLASSIC_SERVICE)
        self.classic = None
        self.classic_lock = threading.Lock()
        # planner.simulate: one at a time, how far it got, cancelled by planner.simulate.cancel
        self.sim_lock = threading.Lock()
        self.sim_cancel = threading.Event()
        self.sim_status = {'running': False}
        self.service = rospy.Service(rospy.get_param('~service', '/slic3r_coverage_planner/plan_path'), PlanPath,
                                     self.handle)
        # planner.area.set: OpenMower's RPC methods asked straight over ROS (as xbot_monitoring hands them on) and their
        # answers by id
        self.asked = {}
        self.ask_ids = itertools.count(1)
        self.ask_request = rospy.Publisher('/xbot/rpc/request', RpcRequest, queue_size=10)
        rospy.Subscriber('/xbot/rpc/response', RpcResponse, self.on_answer)
        rospy.Subscriber('/xbot/rpc/error', RpcError, self.on_answer)
        self.methods.update({'planner.simulate': self.rpc_simulate,
                             'planner.simulate.status': self.rpc_simulate_status,
                             'planner.simulate.cancel': self.rpc_simulate_cancel,
                             'planner.calib.start': self.calib.rpc_start, 'planner.calib.stop': self.calib.rpc_stop,
                             'planner.calib.result': self.calib.rpc_result,
                             'planner.calib.check': self.calib.rpc_check})
        if rospy.get_param('~rpc', True):
            self.rpc = XbotRpc('mowbite_planner', self.methods)
        self.web = None
        port = int(rospy.get_param('~web_port', 0) or 0)
        if port:
            try:
                self.web = WebPage(port, self.methods, self.current_map)
                rospy.loginfo('MowBite Planner: settings page on port %d', port)
            except OSError as e:  # (taken: the planner plans all the same)
                rospy.logwarn('MowBite Planner: no settings page on port %d: %s', port, e)
        rospy.loginfo('MowBite Planner answers %s', self.service.resolved_name)

    # PlannerCore's adapter (see mowbite_planner.core)

    def loginfo(self, *args, **kwargs):
        rospy.loginfo(*args, **kwargs)

    def logwarn(self, *args, **kwargs):
        rospy.logwarn(*args, **kwargs)

    def logerr(self, *args, **kwargs):
        rospy.logerr(*args, **kwargs)

    def logwarn_throttle(self, period, message):
        rospy.logwarn_throttle(period, message)

    def publish(self, topic, payload, retain):
        """Out over MQTT, through xbot_monitoring."""
        self.mqtt.publish(MqttPublish(topic=topic, payload=payload, retain=retain))

    def param(self, name, default=None):
        return rospy.get_param(name, default)

    def replace_map(self, data, based_on):
        """OpenMower's map.replace (whoever writes the map last wins)."""
        self.ask('map.replace', [data], MAP_WAIT)

    def remote_state(self):
        return self.remote.state() if self.remote is not None else ('no house computer', None)

    def drive_ignored(self):
        """Why drive slope and reverse are planned forwards and back_out is off here ('' where they aren't): planner
        slic3r, or OpenMower's FTC not backing up where a plan does (/move_base_flex/FTCPlanner/back_up_with_plan not
        true: after going back to an OpenMower without it the mower must not get plans backing up)."""
        if self.current.planner == 'slic3r':
            return NO_BACKING_SLIC3R
        if rospy.get_param(FTC_PARAMS + '/back_up_with_plan', False) is not True:
            return NO_BACKING
        return ''

    @staticmethod
    def mower_ready():
        """Whether the mower is idle in its dock with no emergency and no rain (the sensor as it is, only with
        /mower_logic/rain_mode on: a start by action doesn't wait for the rain to end)."""
        try:
            state = rospy.wait_for_message(STATE_TOPIC, HighLevelStatus, timeout=READY_POLL)
            if state.state_name != 'IDLE' or not state.is_charging or state.emergency:
                return False
            return not (rospy.get_param('/mower_logic/rain_mode', 0) and
                        rospy.wait_for_message(STATUS_TOPIC, Status, timeout=READY_POLL).rain_detected)
        except rospy.ROSException:
            return False

    def held(self):
        """The MowBite Updater's hold (HoldReader)."""
        return self.hold.held() if self.hold else ''

    def start_mowing(self):
        self.action.publish(String(data=START_ACTION))

    def job_complete(self):
        self.calib.job_complete()

    def on_map(self, msg):
        self.set_map(msg.data)

    def on_publish(self, msg):
        """mower_logic's events (xbot_mqtt.publishEvent)."""
        if msg.topic == EVENTS_TOPIC:
            self.on_event(msg.payload)

    def ask(self, method, params, wait):
        """Another node's RPC method (OpenMower's), its result. PlanningError where it says no or doesn't answer in
        wait s."""
        rid = 'mowbite_planner-%x-%d' % (int(time.time()), next(self.ask_ids))
        waiting = self.asked[rid] = {'done': threading.Event()}
        try:
            self.ask_request.publish(RpcRequest(method=method, params=json.dumps(params), id=rid))
            if not waiting['done'].wait(wait):
                raise PlanningError('OpenMower didn\'t answer %s in %.0f s' % (method, wait))
        finally:
            self.asked.pop(rid, None)
        if 'error' in waiting:
            raise PlanningError('OpenMower: %s' % waiting['error'])
        return waiting.get('result')

    def on_answer(self, msg):
        """An answer on /xbot/rpc/response or /xbot/rpc/error, one of ask()'s or another's."""
        waiting = self.asked.get(msg.id)
        if waiting is None:
            return
        if hasattr(msg, 'code'):
            waiting['error'] = msg.message
        else:
            try:
                waiting['result'] = json.loads(msg.result)
            except ValueError:
                waiting['result'] = msg.result
        waiting['done'].set()

    def rpc_simulate(self, params):
        """planner.simulate, see the top: one at a time, how far it got in sim_status meanwhile."""
        if not self.sim_lock.acquire(False):
            raise PlanningError('a simulation is running')
        try:
            self.sim_cancel.clear()
            started, area = time.time(), [params.get('area_id')]

            def status(phase, fraction):
                if self.sim_cancel.is_set():
                    raise Cancelled()
                self.sim_status = {'running': True, 'area_id': area[0], 'phase': phase,
                                   'fraction': round(min(1.0, max(0.0, fraction)), 3),
                                   'elapsed_s': round(time.time() - started, 1)}

            status('planning', 0.0)
            return self.simulated(params, status, area)
        except Cancelled:
            raise PlanningError('cancelled') from None
        finally:
            self.sim_status = dict(self.sim_status, running=False)
            self.sim_lock.release()

    def rpc_simulate_status(self, params):
        return dict(self.sim_status)

    def rpc_simulate_cancel(self, params):
        running = bool(self.sim_status.get('running'))
        if running:
            self.sim_cancel.set()
        return {'cancelled': running}

    def simulated(self, params, status, area):
        """planner.simulate's answer, saying how far it got to status(phase, fraction of all of it) (area[0]: the area's
        id once it's planned)."""
        params = dict(params)
        model = self.sim_model(params.pop('model', None))
        seeds = params.pop('seeds', 1)
        if isinstance(seeds, bool) or not isinstance(seeds, int) or not 1 <= seeds <= SIM_SEEDS:
            raise PlanningError('seeds must be a whole number 1..%d' % SIM_SEEDS)
        track = params.pop('track', False)
        step = params.pop('playback', None)
        if step is not None and (isinstance(step, bool) or not isinstance(step, (int, float)) or
                                 not SIM_PLAYBACK[0] <= step <= SIM_PLAYBACK[1]):
            raise PlanningError('playback must be s between two points, %g..%g' % SIM_PLAYBACK)
        for name in ('poses', 'report', 'trace'):
            params.pop(name, None)
        keep = []
        area_id = params.get('area_id')
        planned = self.worker.run(ASKED, self.rpc_plan, params, keep,
                                  area_id=area_id if isinstance(area_id, str) else None)
        if not keep:
            raise PlanningError('no plan to simulate')
        # (a copy of its own, simulated and evaluated here: the worker meanwhile at the one kept)
        plan = self.worker.run(ASKED, lambda: pickle.loads(pickle.dumps(keep[-1], protocol=4)))
        area[0] = planned.get('area_id')
        runs = []
        share = (1.0 - SIM_SHARES[0]) / seeds
        for k in range(seeds):
            at = SIM_SHARES[0] + k * share
            got = simulate(plan, model.with_overrides({'seed': model.seed + k}),
                           progress=lambda f: status('simulating', at + SIM_SHARES[1] * share * f))
            runs.append((got, evaluate(plan, got, progress=lambda f: status(
                'evaluating', at + SIM_SHARES[1] * share + (1.0 - SIM_SHARES[1]) * share * f))))
        got, ev = runs[0]
        out = {'area_id': planned.get('area_id'), 'fingerprint': planned.get('fingerprint'),
               'kept': planned.get('kept'), 'model': self.sim_values(model),
               'duration': {'min': round(ev['s'] / 60.0, 1), 'mow_min': round(ev['mow_s'] / 60.0, 1),
                            'model_min': round(ev['model_s'] / 60.0, 1)},
               'nav_errors': [[round(plan.poses[i].x, 3), round(plan.poses[i].y, 3)] for _, i in got.nav_errors]}
        out.update({k: ev[k] for k in ('driven_m', 'mowed_m2', 'left_m2', 'left_pieces', 'planned_left_m2', 'left',
                                       'body', 'aborted', 'tracking', 'spins') if k in ev})
        if seeds > 1:
            out['runs'] = [{'seed': model.seed + k, 'min': round(e['s'] / 60.0, 1), 'left_m2': e.get('left_m2'),
                            'worst': e['body']['worst'], 'nav_errors': e['nav_errors'], 'aborted': e['aborted']}
                           for k, (_, e) in enumerate(runs)]
        if step is not None:  # where it really was, for an app to play it back
            out['playback'] = [[round(t, 1), round(x, 3), round(y, 3), round(yaw, 2), 1 if blade else 0]
                               for t, x, y, yaw, _, _, _, blade, _, _ in self.every(got.samples, step)]
        if track:
            out['track'] = [{'blades': seg['attributes']['blades'],
                             'points': [[round(x, 3), round(y, 3)] for x, y in seg['points']]} for seg in got.history]
            out['events'] = [dict({k: v for k, v in e.items() if k not in ('job_id', 'session_id')},
                                  t=round(e['t'] - got.t0, 1)) for e in got.events]
        rospy.loginfo('MowBite Planner: %s simulated (%s): %.0f min, %.2f m2 left (%.2f planned), body %.0f cm into '
                      'the margins the most, %d navigation errors%s', 'area %s' % out['area_id'] if out['area_id']
                      else 'an outline', 'seed %d' % model.seed if seeds == 1 else '%d seeds' % seeds,
                      ev['s'] / 60.0, ev.get('left_m2', 0.0), ev.get('planned_left_m2', 0.0),
                      100.0 * ev['body']['worst'], ev['nav_errors'], ', given up' if ev['aborted'] else '')
        return out

    @staticmethod
    def every(samples, step):
        """The samples step s apart at least (the first and the last ones always)."""
        out, after = [], None
        for s in samples:
            if after is None or s[0] >= after:
                out.append(s)
                after = s[0] + step
        if samples and out[-1] is not samples[-1]:
            out.append(samples[-1])
        return out

    @staticmethod
    def sim_model(spec):
        """planner.simulate's mower: a preset (SIM_PRESETS, realistic without one), over it this mower's own values
        (FTC_PARAMS, SIM_PARAMS), over those spec's: a preset's name or {preset, name: value, ...}."""
        values = {}
        if spec is None or isinstance(spec, str):
            name = spec or 'realistic'
        elif isinstance(spec, dict):
            values = dict(spec)
            name = values.pop('preset', 'realistic')
        else:
            raise PlanningError('model must be a preset (%s) or an object of its values' % ', '.join(SIM_PRESETS))
        if name not in SIM_PRESETS:
            raise PlanningError('no model preset %r: %s' % (name, ', '.join(SIM_PRESETS)))
        own = {}
        ftc = rospy.get_param(FTC_PARAMS, {})
        for k, v in (ftc.items() if isinstance(ftc, dict) else ()):
            if k in MowerModel.names() and isinstance(v, (int, float)) and \
                    isinstance(v, bool) == isinstance(getattr(MowerModel, k), bool):  # (back_up_with_plan)
                own[k] = v
        for k, param in SIM_PARAMS.items():
            v = rospy.get_param(param, None)
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                own[k] = v
        return SIM_PRESETS[name]().with_overrides(own).with_overrides(values)

    @staticmethod
    def sim_values(model):
        """The model's values that aren't those of an ideal mower (how it differs from one), and its seed."""
        ideal = MowerModel()
        return dict({k: getattr(model, k) for k in MowerModel.names() if getattr(model, k) != getattr(ideal, k)},
                    seed=model.seed)

    def classic_answer(self, req):
        """The slic3r planner's answer, PlanningError when there's none."""
        try:
            rospy.wait_for_service(self.classic_name, timeout=CLASSIC_WAIT)
            with self.classic_lock:  # (a proxy takes one call at a time)
                if self.classic is None:
                    self.classic = rospy.ServiceProxy(self.classic_name, PlanPath)
                return self.classic(req)
        except (rospy.ROSException, rospy.ServiceException) as e:
            raise PlanningError('no answer from the slic3r planner (%s): %s' % (self.classic_name, e))

    def classic_plan(self, boundary, obstacles, cfg, *rest, **more):
        """planner.plan with planner slic3r: the slic3r planner asked like mower_logic would, its paths as a plan.
        Every path is a section of its own (OpenMower drives to the start of each itself), loops perimeter, the rest
        lanes. (The navigation areas, reach_over, mean nothing to it.)"""
        t0 = time.perf_counter()
        concentric = cfg.fill_pattern == 'concentric'
        req = PlanPathRequest(
            fill_type=PlanPathRequest.FILL_CONCENTRIC if concentric else PlanPathRequest.FILL_LINEAR,
            angle=float(cfg.angle or 0.0), distance=cfg.lane_spacing,
            outer_offset=float(cfg.perimeter_offset or 0.0), outline_count=cfg.passes,
            outline_overlap_count=cfg.lane_overlap_passes, skip_area_outline=cfg.skip_outline_loops,
            skip_obstacle_outlines=cfg.skip_obstacle_loops, skip_fill=cfg.skip_lanes,
            outline=Polygon(points=[Point32(x=x, y=y, z=0.0) for x, y in boundary]),
            holes=[Polygon(points=[Point32(x=x, y=y, z=0.0) for x, y in o]) for o in obstacles])
        poses, segments, starts, loops = [], [], [], []
        for path in self.classic_answer(req).paths:
            pts = [Pose2D(ps.pose.position.x, ps.pose.position.y, quaternion_to_yaw(
                ps.pose.orientation.x, ps.pose.orientation.y, ps.pose.orientation.z, ps.pose.orientation.w))
                for ps in path.path.poses]
            if not pts:
                continue
            starts.append(len(poses))
            segments.append(SegmentInfo(limits.PERIMETER if path.is_outline else limits.LANE, len(poses),
                                        len(poses) + len(pts) - 1, False, '', len(starts) - 1))
            if path.is_outline:
                loops.append([(p.x, p.y) for p in pts])
            poses.extend(pts)
        if not poses:
            raise PlanningError('the slic3r planner gave no paths')
        length = sum(math.hypot(b.x - a.x, b.y - a.y) for s in segments
                     for a, b in zip(poses[s.start:s.end], poses[s.start + 1:s.end + 1]))
        area = clean_polygon(boundary)
        free = polygonal(area.difference(union(clean_polygon(o) for o in obstacles))) if obstacles else area
        stats = {'path_length': length, 'poses': len(poses), 'paths': len(starts), 'area': free.area,
                 'planning_time': time.perf_counter() - t0,
                 'chosen': {'lane_spacing': round(cfg.lane_spacing, 4), 'perimeter_passes': cfg.passes,
                            'mode': 'fixed'}}
        # (its poses are as far apart as it puts them, the gaps between them aren't checked)
        return CoveragePlan(poses=poses, segments=segments, angle=req.angle, lane_spacing=cfg.lane_spacing,
                            perimeter_loops=loops, lanes=[], stats=stats,
                            warnings=["planned by OpenMower's slic3r planner (planner slic3r)"], area=area,
                            free_space=free, angles=[req.angle], config=dataclasses.replace(cfg, waypoint_spacing=0.0),
                            section_starts=starts)

    def settings(self, req, job):
        """The node's settings, then what mower_logic asks for, then the area's own (planner property and
        angle range)."""
        current = self.current
        width = max(current.mower_width, req.distance)
        asked = dict(
            mower_width=width,
            # OpenMower's distance is the lane spacing
            overlap=1.0 - req.distance / width,
            perimeter_offset=float(req.outer_offset),
            perimeter_passes=int(req.outline_count),
            lane_overlap_passes=int(req.outline_overlap_count),
            skip_outline_loops=bool(req.skip_area_outline),
            skip_obstacle_loops=bool(req.skip_obstacle_outlines),
            skip_lanes=bool(req.skip_fill),
        )
        # the area's own angle (mower_logic adds mow_angle_offset) beats settings, its planner property beats both
        if not current.own_angle or (job is not None and job.overrides.get('angle') is not None):
            asked['angle'] = float(req.angle)
        if req.fill_type == PlanPathRequest.FILL_CONCENTRIC:
            asked['fill_pattern'] = 'concentric'
        # set here, they beat mower_logic's, but not the area's own (its outline_count, ...)
        for name in current.own:
            asked.pop(name, None)
        if 'overlap' in current.own:  # the blade, not widened to mower_logic's lane spacing
            asked['mower_width'] = current.mower_width
        cfg = current.base.with_overrides(asked)
        if job is not None:
            cfg = cfg.with_overrides({n: v for n, v in job.overrides.items() if n in current.own})
            cfg = cfg.with_overrides(job.planner)
        if cfg.lane_spacing_mode == 'auto':  # the blade, the spacing is the planner's
            cfg = cfg.with_overrides({'mower_width': current.mower_width})
        return cfg.with_overrides({'angle_steps': self.angle['steps'], 'finished_mows': self.angle['finished']})

    def remote_plan(self, key, form, args, reach_over, unmowed, area_id):
        """remote_planning: the plan from the house computer where it's asked and its plan taken (read with the
        geometry and config of here, nothing refused: remote.plan_from, refused), else None, why in the log (when it
        changed) and the progress. Waits REMOTE_TIMES what the area's last planning took (REMOTE_MIN_WAIT at least,
        REMOTE_FIRST without one), REMOTE_STALL s without a word. PlanningError: the planner's no there."""
        if not self.current.remote_planning or self.remote is None:
            return None
        why = self.remote.ready()
        if not why:
            took = self.progress.took.get(area_id)
            self.progress.where('house')
            data, why = self.remote.ask(key, form, max(REMOTE_MIN_WAIT, REMOTE_TIMES * took) if took else REMOTE_FIRST,
                                        self.progress.step)
            if data is not None:
                try:
                    plan = plan_from(unpack(data), args, reach_over, unmowed)
                    why = refused(plan)
                    if not why:
                        self.remote_said = ''
                        return plan
                    why = 'its plan refused: ' + why
                except Exception as e:  # noqa: BLE001 - whatever it sent, planned here then
                    why = 'its plan: %s: %s' % (type(e).__name__, e)
        if why != self.remote_said:
            rospy.logwarn('MowBite Planner: planned here, not on the house computer: %s', why)
            self.remote_said = why
        self.progress.where('mower', why)
        return None

    def handle(self, req):
        """mower_logic's plan_path, in the worker before anything else waiting there."""
        return self.worker.run(MOWER, self.plan_path, req, job='mower')

    def plan_path(self, req):
        if self.current.planner == 'slic3r':  # mower_logic's request as it came
            try:
                res = self.classic_answer(req)
                rospy.loginfo('MowBite Planner: %d paths from the slic3r planner (planner slic3r)', len(res.paths))
                return res
            except PlanningError as e:
                rospy.logerr('MowBite Planner: %s, the MowBite Planner plans', e)
        res = PlanPathResponse()
        boundary = [(p.x, p.y) for p in req.outline.points]
        obstacles = [[(p.x, p.y) for p in hole.points] for hole in req.holes]
        with self.lock:
            data = self.map
        index = match_area(data, boundary) if data else None
        job, drivable, keep_out, dock, reach_over, unmowed = None, [], [], None, [], []
        try:
            if index is not None:
                job = area_job(data, index)
                # mower_logic sends the map's obstacles (or the ones mowing.plan was given), not these
                obstacles += job.mow_around
                drivable, keep_out, dock, reach_over = job.drivable, job.keep_out, job.dock, job.navigation
                unmowed = job.unmowed
            armed, left = self.armed_plan(job)
            if armed:
                # planner.leftovers armed: what the mow before left in this area, nothing where it left nothing
                stamp = rospy.Time.now()
                for is_outline, first, last in plan_pieces(left, self.max_poses) if left is not None else ():
                    res.paths.append(PlannerPath(is_outline=1 if is_outline else 0,
                                                 path=self.to_path(left.poses[first:last + 1], stamp)))
                rospy.loginfo('MowBite Planner: area %s, the leftovers: %s', job.area_id, 'nothing' if left is None
                              else '%d paths, %.0f m, %d passes' % (len(res.paths), left.stats['path_length'],
                                                                   left.stats['leftovers']['passes']))
                return res
            cfg = self.settings(req, job)
            if job is not None and cfg.nested_areas:
                obstacles += job.nested  # the mowing areas in this one, mowed on their own
            # the map's obstacles (areas to keep out of) with a margin of their own, by their outline
            margins = margins_for(data, obstacles + keep_out)
            # (the end as planner.plan gives it, the heading doesn't count there: planned ahead it's this plan)
            plan, kept = self.kept_plan(boundary, obstacles, cfg, start=dock, end=dock[:2] if dock else None,
                                        drivable=drivable, keep_out=keep_out, margins=margins, reach_over=reach_over,
                                        unmowed=unmowed)
            self.pin(self.local.key)
        except PlanningError as e:
            rospy.logwarn('MowBite Planner: %s', e)
            return res
        except Exception as e:  # noqa: BLE001 - a bad area must not take the planner down
            rospy.logerr('MowBite Planner failed: %s: %s', type(e).__name__, e, exc_info=True)
            return res
        self.serve(job.area_id if job else None, plan)
        stamp = rospy.Time.now()
        for is_outline, first, last in plan_pieces(plan, self.max_poses):
            res.paths.append(PlannerPath(is_outline=1 if is_outline else 0,
                                         path=self.to_path(plan.poses[first:last + 1], stamp)))
        st = plan.stats
        if not plan.warnings:
            warnings = ''
        elif self.warned.get(id(plan)) is plan:
            warnings = ', %d warnings as before' % len(plan.warnings)
        else:
            warnings = '. ' + '; '.join(plan.warnings)
            self.warned[id(plan)] = plan
        rospy.loginfo('MowBite Planner: %s%d paths, %d poses, %.0f m, lanes at %.1f deg, %s%s',
                      'area %s, ' % job.area_id if job else '', len(res.paths), len(plan.poses),
                      st['path_length'], math.degrees(plan.angle),
                      'kept from before' if kept else '%.0f ms' % (1000 * st['planning_time']), warnings)
        return res

    def to_path(self, poses, stamp):
        header = Header(frame_id=self.frame_id, stamp=stamp)
        path = Path(header=header)
        for p in poses:
            x, y, z, w = yaw_to_quaternion(p.yaw)
            path.poses.append(PoseStamped(header=header, pose=Pose(position=Point(x=p.x, y=p.y, z=0.0),
                                                                   orientation=Quaternion(x=x, y=y, z=z, w=w))))
        return path


def master_restarted(run_id):
    """Whether the master now has another /run_id than run_id. While it's down: no (the new one comes later)."""
    try:
        return rospy.get_param('/run_id', run_id) != run_id
    except OSError:
        return False


def main():
    rospy.init_node('slic3r_coverage_planner')
    MowbitePlannerRos1()
    run_id = rospy.get_param('/run_id', None)
    while not rospy.is_shutdown():
        time.sleep(MASTER_CHECK)
        if run_id is not None and master_restarted(run_id):
            rospy.logwarn('MowBite Planner: the ROS master restarted, ending to register again')
            rospy.signal_shutdown('ROS master restarted')
            raise SystemExit(1)


if __name__ == '__main__':
    main()

