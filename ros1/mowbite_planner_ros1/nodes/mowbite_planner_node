class LogLines(logging.Handler):
    """The node's last LOG_LINES log lines for planner.log, on the logger rospy.loginfo... write to (rosout). The
    unexpected errors come with their traceback, rospy's own in callbacks too."""

    def __init__(self):
        logging.Handler.__init__(self, logging.INFO)
        self.lines = collections.deque(maxlen=LOG_LINES)

    def emit(self, record):
        try:
            # (logfatal's CRITICAL as an ERROR)
            self.lines.append({'t': record.created, 'level': logging.getLevelName(min(record.levelno, logging.ERROR)),
                               'msg': self.format(record)})
        except Exception:  # noqa: BLE001 - a log line must not take the planner down
            self.handleError(record)

    def after(self, since, limit):
        """The lines after since (unix s), only the newest limit of them, the oldest first."""
        with self.lock:
            lines = [line for line in self.lines if line['t'] > since]
        return lines[-limit:]


LOG = LogLines()


class XbotRpc:
    """OpenMower's RPC methods from Python, like xbot_mqtt's RpcProvider: xbot_monitoring hands the requests
    for registered methods to /xbot/rpc/request, the answers go back on /xbot/rpc/response or /xbot/rpc/error.
    methods: name -> callback(params) giving the result, a PlanningError is the caller's mistake."""

    def __init__(self, node_id, methods):
        self.node_id, self.methods = node_id, methods
        self.response = rospy.Publisher('/xbot/rpc/response', RpcResponse, queue_size=100)
        self.error = rospy.Publisher('/xbot/rpc/error', RpcError, queue_size=100)
        self.register = rospy.ServiceProxy('/xbot/rpc/register', RegisterMethodsSrv)
        rospy.Subscriber('/xbot/rpc/request', RpcRequest, self.on_request, queue_size=100, tcp_nodelay=True)
        # latched by xbot_monitoring when it starts: it forgot the methods, register them again
        rospy.Subscriber('/xbot/rpc/registry', Empty, lambda _: self.publish_methods())
        threading.Thread(target=self.publish_methods, daemon=True).start()

    def publish_methods(self):
        try:
            rospy.wait_for_service('/xbot/rpc/register', timeout=30.0)
            self.register(self.node_id, sorted(self.methods))
        except (rospy.ROSException, rospy.ServiceException) as e:  # RPCs aren't needed for mowing
            rospy.logwarn('MowBite Planner: RPC methods not registered: %s', e)

    def on_request(self, req):
        if req.method not in self.methods:  # another node's
            return
        try:
            try:
                params = json.loads(req.params) if req.params else None
            except ValueError:
                params = []
            if params is None:  # none given, or null
                params = {}
            if not isinstance(params, dict):
                raise PlanningError('params must be an object (by name)')
            result = json.dumps(self.methods[req.method](params), allow_nan=False)
        except PlanningError as e:
            rospy.loginfo('MowBite Planner: %s: %s', req.method, e)
            return self.fail(req, RpcError.ERROR_INVALID_PARAMS, str(e))
        except Exception as e:  # noqa: BLE001 - an RPC must not take the planner down
            rospy.logerr('MowBite Planner: %s failed: %s: %s', req.method, type(e).__name__, e, exc_info=True)
            return self.fail(req, RpcError.ERROR_INTERNAL, 'internal error: %s' % e)
        if req.id:
            self.response.publish(RpcResponse(result=result, id=req.id))

    def fail(self, req, code, message):
        if req.id:
            self.error.publish(RpcError(code=code, message=message, id=req.id))


class MowbitePlannerRos1:
    def __init__(self):
        # (after rospy.init_node: it sets up rosout's handlers anew)
        logging.getLogger('rosout').addHandler(LOG)
        self.launch_width = float(rospy.get_param('~mower_width', 0.18))
        self.launch = dict(rospy.get_param('~settings', {}) or {})
        self.defaults = self.setup(self.launch_width, self.launch, {})
        self.file = os.path.expanduser(rospy.get_param('~settings_file', os.path.join(
            os.environ.get('ROS_HOME', '~/.ros'), 'mowbite_planner_settings.json')))
        # swapped as a whole, a plan never sees half of a change
        self.current = self.defaults
        stored = self.read_stored()
        # (one a newer version stored: left out, the rest still counts)
        unknown = sorted(set(stored) - set(PlannerConfig.names()) - set(NODE_SETTINGS) - set(limits.INTERNAL) -
                         set(limits.RETIRED))
        if unknown:
            rospy.logwarn('MowBite Planner: stored settings not known, left out (%s): %s', self.file,
                          ', '.join(unknown))
            stored = {n: v for n, v in stored.items() if n not in unknown}
        if stored:
            try:
                self.current = self.setup(self.launch_width, self.launch, stored)
            except PlanningError as e:  # the launch file changed since, its settings still work
                rospy.logwarn('MowBite Planner: stored settings left out (%s): %s', self.file, e)
        # OpenMower's FTC controller needs 3 poses a path, pieces of at most 3 can't always have them
        self.max_poses = max(4, int(rospy.get_param('~max_path_poses', MAX_PATH_POSES)))
        self.frame_id = rospy.get_param('~frame_id', 'map')
        self.map = None
        self.lock = threading.Lock()
        self.set_lock = threading.Lock()
        self.plans = collections.OrderedDict()
        self.plans_lock = threading.Lock()
        self.planning = {}  # a lock for each plan being planned: asked for again meanwhile, it's waited for
        self.plans_dir = os.path.expanduser(rospy.get_param('~plans_dir', os.path.join(
            os.environ.get('ROS_HOME', '~/.ros'), 'mowbite_plans')))
        self.code = code_version()
        self.drop_old_plans()
        self.ahead = None
        self.ahead_lock = threading.Lock()
        self.ahead_count = 0  # (the latest plan_ahead, one before it ends early)
        self.ahead_run = threading.Lock()
        # the finished mows counted for angle_increment: steps so far, mows since the last one, and all of them
        # (perimeter_direction random), next to settings_file
        self.angle_file = os.path.join(os.path.dirname(self.file), 'mowbite_planner_angle.json') if self.file else ''
        self.angle_lock = threading.Lock()
        self.angle = self.read_angle()
        self.local = threading.local()  # whether the last plan of this thread was kept from before
        # the plans whose warnings are in the log already (by id): asked for again, a preview or the mow, only how many
        self.warned = weakref.WeakValueDictionary()
        self.history = os.path.expanduser(rospy.get_param('~history_dir', os.path.join(
            os.environ.get('ROS_HOME', '~/.ros'), HISTORY_DIR)))
        self.drive = None  # the last finished mow's planner.drive
        self.drive_thread = None
        # [[estimate s, took s, job id], ...] of the last finished mows, and the plans mower_logic got: [(when, area id,
        # estimate s)]
        self.timing_file = os.path.join(os.path.dirname(self.file), 'mowbite_planner_timing.json') if self.file else ''
        self.timing_lock = threading.Lock()
        self.timing = self.read_timing()
        self.served = collections.deque(maxlen=64)
        # planner.leftovers armed: {'until': when it ends, 'plans': {area id: its leftovers' plan or None}, 'served':
        # mower_logic got one of them}
        self.armed = None
        # the job of mower_logic's last event ('' none), see track_written
        self.job = ''
        self.job_change = threading.Condition()
        if rospy.get_param('~use_map', True):
            rospy.Subscriber(rospy.get_param('~map_topic', '/mower_map_service/json_map'), String, self.on_map)
        rospy.Subscriber('/xbot_monitoring/mqtt_publish', MqttPublish, self.on_publish)
        self.action = rospy.Publisher(ACTION_TOPIC, String, queue_size=1)
        self.classic_name = rospy.get_param('~classic_service', CLASSIC_SERVICE)
        self.classic = None
        self.classic_lock = threading.Lock()
        self.service = rospy.Service(rospy.get_param('~service', '/slic3r_coverage_planner/plan_path'), PlanPath,
                                     self.handle)
        if rospy.get_param('~rpc', True):
            self.rpc = XbotRpc('mowbite_planner', {'planner.settings': self.rpc_settings,
                                                   'planner.settings.set': self.rpc_settings_set,
                                                   'planner.plan': self.rpc_plan,
                                                   'planner.drive': self.rpc_drive,
                                                   'planner.leftovers': self.rpc_leftovers,
                                                   'planner.angle.reset': self.rpc_angle_reset,
                                                   'planner.log': self.rpc_log})
        rospy.loginfo('MowBite Planner answers %s', self.service.resolved_name)

    @property
    def base(self):
        return self.current.base

    @staticmethod
    def setup(width, settings, stored):
        """The settings with the stored ones on top, PlanningError if they don't go together."""
        # (settings of before left out, they're fixed now or gone)
        stored = {n: v for n, v in stored.items() if n not in limits.INTERNAL and n not in limits.RETIRED}
        on_top = {n: v for n, v in stored.items() if n != 'mower_width'}
        settings = dict(settings, **on_top)
        planner = settings.pop('planner', PLANNERS[0])
        if planner not in PLANNERS:
            raise PlanningError('planner must be one of %s' % ', '.join(PLANNERS))
        leftovers_auto = settings.pop('leftovers_auto', False)
        if not isinstance(leftovers_auto, bool):
            raise PlanningError('leftovers_auto must be true or false')
        # OpenMower's FTC controller only drives forwards: lanes far enough apart that every turn is a forward U-turn
        # of turn_radius. ~settings can change that (and anything else)
        base = PlannerConfig(lane_order='skip').with_overrides(settings)
        # (checked with the blade's width: lane_spacing_min and lane_spacing_max go by it)
        blade = base.with_overrides({'mower_width': stored.get('mower_width', width)})
        blade.validate()
        # with angle or angle_strategy in settings the lanes go that way, not mower_logic's angle, unless the area
        # has its own
        own_angle = 'angle' in settings or 'angle_strategy' in settings
        # as the planner took them: ints of a float setting as floats, turn_types as a list
        node = {'planner': planner, 'leftovers_auto': leftovers_auto}
        stored = {n: node[n] if n in node else getattr(blade if n == 'mower_width' else base, n) for n in stored}
        return Setup(blade.mower_width, base, own_angle,
                     {n: list(v) if isinstance(v, tuple) else v for n, v in stored.items()},
                     frozenset(n for n in settings if n in MOWER_LOGIC), planner, leftovers_auto)

    def read_stored(self):
        if not self.file or not os.path.exists(self.file):
            return {}
        try:
            with open(self.file) as f:
                stored = json.load(f)
            if not isinstance(stored, dict):
                raise ValueError('not an object')
            return stored
        except (OSError, ValueError) as e:
            rospy.logwarn('MowBite Planner: stored settings not readable (%s): %s', self.file, e)
            return {}

    def write_stored(self, stored):
        if not self.file:
            return
        tmp = self.file + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(stored, f, indent=1, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.file)

    def rpc_settings(self, params=None):
        current, defaults = self.current, self.defaults
        theirs = openmower_settings(rospy.get_param('/mower_logic', {}), current.mower_width)
        out = {}
        for name in PlannerConfig.names():
            default = PlannerConfig.__dataclass_fields__[name].default
            kind = ('boolean' if isinstance(default, bool) else 'integer' if isinstance(default, int)
                    else 'string' if isinstance(default, str) else 'list' if isinstance(default, tuple)
                    else 'points' if name in POINTS else 'number')
            blade = name == 'mower_width'
            entry = {'value': current.mower_width if blade else getattr(current.base, name),
                     'default': defaults.mower_width if blade else getattr(defaults.base, name),
                     'stored': name in current.stored, 'type': kind, 'settable': name not in FIXED}
            if name in FIXED:
                entry['from'] = FIXED[name]
            elif name in MOWER_LOGIC and name not in current.own:  # mower_logic's (an area's own still beats it)
                entry['from'] = MOWER_LOGIC[name]
                entry['value'] = theirs.get(name, entry['value'])
            if default is None:
                entry['nullable'] = True
            if name in CHOICES:
                entry['choices'] = CHOICES[name]
            if name in AUTO_VALUES:
                entry['auto_value'] = AUTO_VALUES[name]
            if kind == 'number':
                entry['unit'] = 'rad' if name in RAD else '' if name in ('overlap', 'transit_edge_cost') else 'm'
                if name not in SIGNED:
                    entry['min'] = 0.0
            elif kind == 'points':
                entry['unit'] = 'm'
            if name in RANGES:
                entry['min'], hi = RANGES[name]
                if hi is not None:
                    entry['max'] = hi
            out[name] = {k: list(v) if isinstance(v, tuple) else v for k, v in entry.items()}
        out['planner'] = {'value': current.planner, 'default': defaults.planner, 'stored': 'planner' in current.stored,
                          'type': 'string', 'settable': True, 'choices': list(PLANNERS)}
        out['leftovers_auto'] = {'value': current.leftovers_auto, 'default': defaults.leftovers_auto,
                                 'stored': 'leftovers_auto' in current.stored, 'type': 'boolean', 'settable': True}
        # angle_increment: the steps turned so far and the finished mows towards the next one (and all of them)
        steps, mows = self.angle['steps'], self.angle['mows']
        return {'settings': out, 'own_angle': current.own_angle, 'file': self.file or None,
                'angle_steps': steps, 'angle_mows': mows,
                'angle_turned': steps * current.base.angle_increment, 'finished_mows': self.angle['finished']}

    def rpc_angle_reset(self, params=None):
        """Back to no steps turned (angle_increment)."""
        with self.angle_lock:
            self.angle = dict(self.angle, steps=0, mows=0)
            self.write_angle()
        rospy.loginfo('MowBite Planner: angle steps reset')
        self.plan_ahead_later()
        return self.rpc_settings()

    def rpc_log(self, params):
        """planner.log, see the top."""
        since = params.get('since')
        limit = params.get('limit')
        if since is not None and (isinstance(since, bool) or not isinstance(since, (int, float))):
            raise PlanningError('since must be a time in unix s')
        if limit is not None and (isinstance(limit, bool) or not isinstance(limit, int) or limit < 1):
            raise PlanningError('limit must be a whole number of 1 or more')
        return {'lines': LOG.after(-math.inf if since is None else since, LOG_LINES if limit is None else limit)}

    def read_angle(self):
        try:
            with open(self.angle_file) as f:
                data = json.load(f)
            # (finished: not in it before perimeter_direction random)
            return {'steps': max(0, int(data['steps'])), 'mows': max(0, int(data['mows'])),
                    'finished': max(0, int(data.get('finished', 0)))}
        except (OSError, ValueError, KeyError, TypeError, OverflowError):
            return {'steps': 0, 'mows': 0, 'finished': 0}

    def write_angle(self):
        if not self.angle_file:
            return
        try:
            with open(self.angle_file + '.tmp', 'w') as f:
                json.dump(self.angle, f)
            os.replace(self.angle_file + '.tmp', self.angle_file)
        except OSError as e:
            rospy.logwarn('MowBite Planner: angle steps not kept (%s): %s', self.angle_file, e)

    def on_publish(self, msg):
        """mower_logic's events: every angle_increment_every finished mows (JOB_COMPLETE, not JOB_RESET) one step more,
        while angle_increment turns the lanes (for all areas or one's own)."""
        if msg.topic != EVENTS_TOPIC:
            return
        try:
            event = json.loads(msg.payload)
        except ValueError:
            return
        if not isinstance(event, dict):
            return
        if event.get('type') == 'STATE':
            with self.job_change:
                self.job = event.get('job_id') or ''
                self.job_change.notify_all()
            return
        if event.get('type') == 'JOB_RESET':
            armed = self.armed
            if armed is not None and armed['served']:  # (the leftovers' job thrown away: the next mow is a whole one)
                self.armed = None
            return
        if event.get('type') != 'JOB_COMPLETE':
            return
        armed, self.armed = self.armed, None
        if armed is not None and armed['served']:
            # (the leftovers of the mow before: no mow of its own, the lanes don't turn on, it isn't timed)
            rospy.loginfo('MowBite Planner: the leftovers are mowed')
            self.served.clear()
            return
        with self.job_change:
            self.job = event.get('job_id') or ''
        self.drive_thread = threading.Thread(target=self.after_mow, args=(event.get('job_id'),), daemon=True)
        self.drive_thread.start()
        base = self.current.base
        with self.lock:
            data = self.map
        own = [((a.get('properties') or {}).get('planner') or {}) for a in (data or {}).get('areas', [])]
        turning = base.angle_increment != 0 or any(p.get('angle_increment') for p in own)
        # (perimeter_direction random: from now on another way round, the plans ahead too)
        rolling = base.perimeter_direction == 'random' or any(p.get('perimeter_direction') == 'random' for p in own)
        if turning and rospy.get_param('/mower_logic/mow_angle_increment', 0):
            rospy.logwarn('MowBite Planner: mower_logic turns the lanes too (mow_angle_increment), both add up')
        with self.angle_lock:
            self.angle['finished'] += 1
            if turning:
                self.angle['mows'] += 1
                if self.angle['mows'] >= base.angle_increment_every:
                    self.angle.update(steps=self.angle['steps'] + 1, mows=0)
            self.write_angle()
            steps, finished = self.angle['steps'], self.angle['finished']
        if turning or rolling:
            rospy.loginfo('MowBite Planner: mow finished, angle steps %d, %d finished mows', steps, finished)
            self.plan_ahead_later()

    def rpc_settings_set(self, params):
        fixed = sorted(set(params) & set(FIXED))
        if fixed:
            raise PlanningError('not settable here: %s' % ', '.join('%s (%s)' % (n, FIXED[n]) for n in fixed))
        # (settings of before an app may still send: left out)
        params = {n: v for n, v in params.items() if n not in limits.INTERNAL and n not in limits.RETIRED}
        unknown = sorted(set(params) - set(PlannerConfig.names()) - set(NODE_SETTINGS))
        if unknown:
            raise PlanningError('unknown planner settings: %s' % ', '.join(unknown))
        with self.set_lock:
            stored = dict(self.current.stored)
            for name, value in params.items():
                if value is None:
                    stored.pop(name, None)
                else:
                    stored[name] = value
            current = self.setup(self.launch_width, self.launch, stored)
            self.write_stored(current.stored)
            self.current = current
            self.armed = None  # (the leftovers were other settings')
        rospy.loginfo('MowBite Planner: settings %s', json.dumps(current.stored, sort_keys=True))
        self.plan_ahead_later()
        return self.rpc_settings()

    def rpc_plan(self, params, keep=None, mowed=None):
        """keep: a list the plan itself goes to too. mowed: where the blade went already, only what that left is planned
        (not kept: it's that one mow's)."""
        current = self.current
        with self.lock:
            data = self.map
        if current.planner == 'slic3r' and keep is None:
            # what mower_logic would ask the slic3r planner: OpenMower's settings and the area's, not the node's
            service = PlannerService(PlannerConfig(mower_width=current.mower_width, nested_areas=False))
            service.planner = self.classic_plan
        else:
            service = PlannerService(current.base.with_overrides({'mower_width': current.mower_width,
                                                                  'angle_steps': self.angle['steps'],
                                                                  'finished_mows': self.angle['finished']}),
                                     current.own_angle)
            service.planner = self.plan_coverage if keep is None else (
                lambda *args, **kw: keep.append(self.plan_coverage(*args, **kw)) or keep[-1])
            service.own = current.own
        service.map = data
        service.params = rospy.get_param('/mower_logic', {})
        self.local.kept = False
        got = []
        if mowed is not None:
            service.planner = lambda *args, **kw: got.append(plan_coverage(*args, mowed=mowed, **kw)) or got[-1]
        elif keep is None and current.planner != 'slic3r':
            service.planner = lambda *args, **kw: got.append(self.plan_coverage(*args, **kw)) or got[-1]
        result = service.plan(params)
        if mowed is not None and keep is not None:
            keep.extend(got)
        result['kept'] = self.local.kept  # planned before (ahead, or the same asked for already)
        if got:
            result['duration'] = self.duration(self.estimate(got[-1]))
        return result

    def estimate(self, plan):
        """s the mower takes for plan as the model says (OpenMower's FTC speeds)."""
        return drive_time(plan.poses, rospy.get_param(FTC_PARAMS, {}))['s']

    def duration(self, estimate):
        """planner.plan's duration of a plan the model gives estimate s for: times the finished mows' factor."""
        with self.timing_lock:
            runs = list(self.timing)
        factor = sum(took for _, took, _ in runs) / sum(est for est, _, _ in runs) if runs else 1.0
        return {'min': round(estimate * factor / 60.0, 1), 'model_min': round(estimate / 60.0, 1),
                'factor': round(factor, 3), 'runs': len(runs)}

    def read_timing(self):
        try:
            with open(self.timing_file) as f:
                runs = json.load(f)['runs']
            return [[float(est), float(took), str(job)] for est, took, job in runs][-TIMING_RUNS:]
        except (OSError, ValueError, KeyError, TypeError):
            return []

    def time_after(self, job_id):
        """How long the finished job took against the model, kept for duration (see TIMING_RUNS), in the log."""
        files = glob.glob(os.path.join(self.history, '*_%s.jsonl' % job_id)) if self.history and job_id else []
        if not files:
            return
        try:
            start = float(os.path.basename(files[0]).split('_', 1)[0])
            took = mowing_time(files[0])
        except (OSError, ValueError):
            return
        served = [(area, est) for t, area, est in list(self.served) if t >= start - 5.0]
        self.served.clear()  # (those were for this job)
        areas = [area for area, _ in served]
        if not served or took is None or len(set(areas)) != len(areas):  # (resumed: a plan twice, not counted)
            rospy.loginfo('MowBite Planner: job %s not timed', job_id)
            return
        est = sum(e for _, e in served)
        if not TIMING_RANGE[0] * est <= took <= TIMING_RANGE[1] * est:
            rospy.logwarn('MowBite Planner: job %s took %.0f min, %.0f min estimated: not counted', job_id, took / 60.0,
                          est / 60.0)
            return
        with self.timing_lock:
            self.timing = (self.timing + [[round(est, 1), round(took, 1), str(job_id)]])[-TIMING_RUNS:]
            runs = list(self.timing)
        if self.timing_file:
            try:
                with open(self.timing_file + '.tmp', 'w') as f:
                    json.dump({'runs': runs}, f)
                os.replace(self.timing_file + '.tmp', self.timing_file)
            except OSError as e:
                rospy.logwarn('MowBite Planner: timing not kept (%s): %s', self.timing_file, e)
        rospy.loginfo('MowBite Planner: job %s took %.1f min, %.1f min estimated, factor now %.2f (%d mows)', job_id,
                      took / 60.0, est / 60.0, sum(t for _, t, _ in runs) / sum(e for e, _, _ in runs), len(runs))

    def track_files(self, job_id=None, name=None):
        """The position_history files of a job (or by name), the latest last; without either all of them."""
        files = sorted(glob.glob(os.path.join(self.history, '*.jsonl')), key=os.path.getmtime) if self.history else []
        if name:
            files = [f for f in files if os.path.basename(f) == os.path.basename(str(name))]
        elif job_id:
            files = [f for f in files if f.endswith('_%s.jsonl' % job_id)]
        if not files:
            raise PlanningError('no track in %s' % (self.history or 'position_history'))
        return files

    def rpc_leftovers(self, params):
        """planner.leftovers, see the top."""
        current = self.current
        if current.planner == 'slic3r':
            raise PlanningError('planner slic3r: no leftovers planned')
        files = self.track_files(params.get('job_id'), params.get('file'))
        if not params.get('job_id'):
            # (a file, or the latest: with the other files of its job, mower_logic starts a new one when it restarts)
            job = os.path.basename(files[-1])[:-len('.jsonl')].split('_', 1)[-1]
            files = self.track_files(job) if job and not params.get('file') else files[-1:]
        path = files[-1]
        runs = [pts for f in files for blades, pts in read_runs(f) if blades and pts]
        with self.lock:
            data = self.map
        ids = [params['area_id']] if params.get('area_id') is not None else [
            a.get('id') for a in (data or {}).get('areas', []) if a.get('id') and
            (a.get('properties') or {}).get('type') == 'mow' and (a.get('properties') or {}).get('active') is not False
            and (a.get('properties') or {}).get('mowable') is not False]
        out, plans = {}, {}
        for i in ids:
            keep = []
            try:
                i = self.rpc_plan({'area_id': i}, keep)['area_id']  # (asked for by name or index too: its id)
            except PlanningError as e:
                if params.get('area_id') is not None:
                    raise
                rospy.loginfo('MowBite Planner: area %s, no leftovers: %s', i, e)  # (the other areas still)
                continue
            cfg = keep[-1].config
            mowed = track_mowed(runs, cfg.mower_width, cfg.blade_ahead, cfg.blade_offset)
            left = sum(p.area for p in polygons(keep[-1].free_space.difference(mowed)) if p.area >= LEFT_PIECE)
            got = []
            if left > LEFT_MOST * keep[-1].free_space.area:
                # (not that mow's leftovers: it never mowed this area, or hardly. Armed the area is mowed as ever)
                out[i] = {'area_id': i, 'paths': [], 'left_m2': round(left, 3), 'message':
                          'most of the area is left (%.1f of %.1f m2): a mow of its own, not leftovers' % (
                              left, keep[-1].free_space.area)}
                continue
            try:
                result = self.rpc_plan({'area_id': i, 'poses': bool(params.get('poses'))}, got, mowed)
                if got:
                    result['duration'] = self.duration(self.estimate(got[-1]))
            except PlanningError as e:  # (nothing left the mower gets to)
                result = {'area_id': i, 'paths': [], 'message': str(e)}
            result['left_m2'] = round(left, 3)
            out[i], plans[i] = result, got[-1] if got else None
        if params.get('arm'):
            with self.set_lock, self.lock:
                same = self.current is current and self.map == data
                if same:
                    self.armed = {'until': time.time() + LEFTOVERS_ARMED, 'plans': plans, 'served': False}
            if not same:  # (they'd be the old map's or settings')
                raise PlanningError('the map or the settings changed meanwhile: not armed')
            rospy.loginfo('MowBite Planner: leftovers armed for %.0f s: %s', LEFTOVERS_ARMED, ', '.join(
                '%s %s' % (i, 'nothing' if p is None else '%.2f m2 in %d passes' % (
                    p.stats['leftovers']['area'], p.stats['leftovers']['passes'])) for i, p in plans.items()))
        armed = self.armed
        return {'file': os.path.basename(path), 'files': [os.path.basename(f) for f in files], 'areas': out,
                'armed': max(0.0, round(armed['until'] - time.time(), 1)) if armed else 0.0}

    def rpc_drive(self, params):
        if not params and self.drive is not None:
            return self.drive
        return self.drive_check(params.get('job_id'), params.get('file'), params.get('area_id'))

    def after_mow(self, job_id):
        """What follows a finished mow: its planner.drive and timing, then with leftovers_auto what it left."""
        self.track_written(job_id)
        self.drive_after(job_id)
        if not self.current.leftovers_auto:
            return
        try:
            self.leftovers_after(job_id)
        except PlanningError as e:
            rospy.loginfo('MowBite Planner: no leftovers mowed by itself: %s', e)
        except Exception as e:  # noqa: BLE001 - the leftovers must not take the planner down
            rospy.logerr('MowBite Planner: the leftovers failed: %s: %s', type(e).__name__, e, exc_info=True)

    def track_written(self, job_id):
        """Waits for the finished job's track to be all in its file (see TRACK_WAIT), as it is after that long."""
        if not job_id or TRACK_WAIT <= 0.0:
            return
        with self.job_change:
            ended = self.job_change.wait_for(lambda: self.job != job_id, TRACK_WAIT)
        if ended:
            time.sleep(TRACK_SETTLE)
        else:
            rospy.logwarn('MowBite Planner: job %s not ended after %.0f s, its track as it is', job_id, TRACK_WAIT)

    def leftovers_after(self, job_id):
        """leftovers_auto: planner.leftovers of the finished mow, armed. Where its passes mow LEFTOVERS_AUTO_MIN m2 at
        least the mower is sent out for them as soon as it's ready (the mow's JOB_COMPLETE comes before it docks), while
        they're armed and not asked for yet."""
        self.rpc_leftovers({'job_id': job_id, 'arm': True})
        armed = self.armed
        area = sum(p.stats['leftovers']['area'] for p in armed['plans'].values() if p is not None) if armed else 0.0
        if area < LEFTOVERS_AUTO_MIN:
            if self.armed is armed:
                self.armed = None
            rospy.loginfo('MowBite Planner: %.2f m2 of leftovers to mow, under %.2f: the mower stays in', area,
                          LEFTOVERS_AUTO_MIN)
            return
        while self.armed is armed and not armed['served'] and time.time() < armed['until']:
            if self.mower_ready():
                self.action.publish(String(data=START_ACTION))
                rospy.loginfo('MowBite Planner: the mower sent out for %.2f m2 of leftovers', area)
                return
            time.sleep(READY_POLL)
        rospy.loginfo('MowBite Planner: the mower not sent out for the leftovers, not ready while they were armed')

    @staticmethod
    def mower_ready():
        """Whether the mower is idle in its dock with no emergency and no rain (the sensor as it is, only with
        /mower_logic/rain_mode on: a start by action doesn't wait for the rain to end)."""
        try:
            state = rospy.wait_for_message(STATE_TOPIC, HighLevelStatus, timeout=READY_POLL)
            if state.state_name != 'IDLE' or not state.is_charging or state.emergency:
                return False
            return not (rospy.get_param('/mower_logic/rain_mode', 0) and
                        rospy.wait_for_message(STATUS_TOPIC, Status, timeout=READY_POLL).rain_detected)
        except rospy.ROSException:
            return False

    def drive_after(self, job_id):
        """planner.drive of a finished mow, in the log, and how long it took (time_after)."""
        try:
            self.time_after(job_id)
        except Exception as e:  # noqa: BLE001 - timing must not take the planner down
            rospy.logerr('MowBite Planner: timing the mow failed: %s: %s', type(e).__name__, e, exc_info=True)
        try:
            self.drive = got = self.drive_check(job_id)
        except PlanningError as e:
            rospy.logwarn('MowBite Planner: drive not checked: %s', e)
            return
        except Exception as e:  # noqa: BLE001 - a check must not take the planner down
            rospy.logerr('MowBite Planner: checking the drive failed: %s: %s', type(e).__name__, e, exc_info=True)
            return
        for area_id, a in got['areas'].items():
            if a['places']:
                rospy.logwarn('MowBite Planner: area %s, the body got into the margins at %d places, %.0f cm the most, '
                              'at %s', area_id, len(a['places']), 100 * a['worst'],
                              ', '.join('(%.2f, %.2f) %.0f cm' % (x, y, 100 * m) for x, y, m in a['places'][:5]))
            else:
                rospy.loginfo('MowBite Planner: area %s, the body kept its margins (%d points)', area_id, a['checked'])

    def drive_check(self, job_id=None, name=None, area_id=None):
        """planner.drive: the track of a job (its position_history file, the latest without one) against the plans'
        body_space: where the body at a driven point (facing the next one) got into the margins."""
        if self.current.planner == 'slic3r':
            raise PlanningError('planner slic3r: no body checked')
        files = self.track_files(job_id, name)
        track = read_track(files[-1])
        with self.lock:
            data = self.map
        if area_id is not None:
            ids = [area_id]
        else:
            ids = [a.get('id') for a in (data or {}).get('areas', []) if a.get('id') and
                   (a.get('properties') or {}).get('type') == 'mow' and
                   (a.get('properties') or {}).get('active') is not False]
        docks = [((d.get('position') or {}).get('x'), (d.get('position') or {}).get('y'))
                 for d in (data or {}).get('docking_stations') or []]
        docks = [(x, y) for x, y in docks if isinstance(x, (int, float)) and isinstance(y, (int, float))]
        track = [(p, on) for p, on in track if all(math.hypot(p.x - x, p.y - y) > DOCK_REACH for x, y in docks)]
        # OpenMower's own drives (the blade off: to an area, between them, home) go over the lawns and the navigation
        # areas too, the plan's body_space has only the lawns it may drive through
        ground = []
        for a in (data or {}).get('areas', []):
            if (a.get('properties') or {}).get('type') in ('mow', 'nav'):
                try:
                    ground.append(clean_polygon(_points(a.get('outline'))))
                except ValueError:
                    continue
        ground = union(ground)
        out = {}
        for i in ids:
            keep = []
            try:
                self.rpc_plan({'area_id': i}, keep)
            except PlanningError:
                if area_id is not None:
                    raise
                continue  # (an area with no plan: the others still)
            fp = plan_footprint(keep[-1]) if keep else None
            if fp is None:
                continue
            near = keep[-1].area.buffer(0.5)
            poses = [(p, on) for p, on in track if near.contains(Spot(p.x, p.y))]
            outs = fp.out_by([(None, p) for p, _ in poses]) if poses else []
            # (with the blade off out of it: against those too, their real edges robot_width / 2 out from the lines)
            off = [k for k, ((m, _), (_, on)) in enumerate(zip(outs, poses)) if m > DRIVE_OFF and not on]
            if off and not ground.is_empty:
                cfg = keep[-1].config
                wide = Footprint(fp.space.union(ground.buffer(fp.half - cfg.edge_margin)), cfg.body_outline,
                                 cfg.spin_margin)
                for k, got in zip(off, wide.out_by([(None, poses[k][0]) for k in off])):
                    outs[k] = got
            places, run = [], None
            for (p, _), (m, _) in zip(poses, outs):
                if m > DRIVE_OFF:  # (a place: points one after the other out there, where it's the furthest)
                    if run is None or m > run[2]:
                        run = [round(p.x, 2), round(p.y, 2), m]
                elif run is not None:
                    places.append(run)
                    run = None
            if run is not None:
                places.append(run)
            out[i] = {'checked': len(poses), 'places': places, 'worst': max([m for _, _, m in places], default=0.0)}
        return {'file': os.path.basename(files[-1]), 'areas': out}

    def classic_answer(self, req):
        """The slic3r planner's answer, PlanningError when there's none."""
        try:
            rospy.wait_for_service(self.classic_name, timeout=CLASSIC_WAIT)
            with self.classic_lock:  # (a proxy takes one call at a time)
                if self.classic is None:
                    self.classic = rospy.ServiceProxy(self.classic_name, PlanPath)
                return self.classic(req)
        except (rospy.ROSException, rospy.ServiceException) as e:
            raise PlanningError('no answer from the slic3r planner (%s): %s' % (self.classic_name, e))

    def classic_plan(self, boundary, obstacles, cfg, *rest, **more):
        """planner.plan with planner slic3r: the slic3r planner asked like mower_logic would, its paths as a plan.
        Every path is a section of its own (OpenMower drives to the start of each itself), loops perimeter, the rest
        lanes. (The navigation areas, reach_over, mean nothing to it.)"""
        t0 = time.perf_counter()
        concentric = cfg.fill_pattern == 'concentric'
        req = PlanPathRequest(
            fill_type=PlanPathRequest.FILL_CONCENTRIC if concentric else PlanPathRequest.FILL_LINEAR,
            angle=float(cfg.angle or 0.0), distance=cfg.lane_spacing,
            outer_offset=float(cfg.perimeter_offset or 0.0), outline_count=cfg.passes,
            outline_overlap_count=cfg.lane_overlap_passes, skip_area_outline=cfg.skip_outline_loops,
            skip_obstacle_outlines=cfg.skip_obstacle_loops, skip_fill=cfg.skip_lanes,
            outline=Polygon(points=[Point32(x=x, y=y, z=0.0) for x, y in boundary]),
            holes=[Polygon(points=[Point32(x=x, y=y, z=0.0) for x, y in o]) for o in obstacles])
        poses, segments, starts, loops = [], [], [], []
        for path in self.classic_answer(req).paths:
            pts = [Pose2D(ps.pose.position.x, ps.pose.position.y, quaternion_to_yaw(
                ps.pose.orientation.x, ps.pose.orientation.y, ps.pose.orientation.z, ps.pose.orientation.w))
                for ps in path.path.poses]
            if not pts:
                continue
            starts.append(len(poses))
            segments.append(SegmentInfo(limits.PERIMETER if path.is_outline else limits.LANE, len(poses),
                                        len(poses) + len(pts) - 1, False, '', len(starts) - 1))
            if path.is_outline:
                loops.append([(p.x, p.y) for p in pts])
            poses.extend(pts)
        if not poses:
            raise PlanningError('the slic3r planner gave no paths')
        length = sum(math.hypot(b.x - a.x, b.y - a.y) for s in segments
                     for a, b in zip(poses[s.start:s.end], poses[s.start + 1:s.end + 1]))
        area = clean_polygon(boundary)
        free = polygonal(area.difference(union(clean_polygon(o) for o in obstacles))) if obstacles else area
        stats = {'path_length': length, 'poses': len(poses), 'paths': len(starts), 'area': free.area,
                 'planning_time': time.perf_counter() - t0,
                 'chosen': {'lane_spacing': round(cfg.lane_spacing, 4), 'perimeter_passes': cfg.passes,
                            'mode': 'fixed'}}
        # (its poses are as far apart as it puts them, the gaps between them aren't checked)
        return CoveragePlan(poses=poses, segments=segments, angle=req.angle, lane_spacing=cfg.lane_spacing,
                            perimeter_loops=loops, lanes=[], stats=stats,
                            warnings=["planned by OpenMower's slic3r planner (planner slic3r)"], area=area,
                            free_space=free, angles=[req.angle], config=dataclasses.replace(cfg, waypoint_spacing=0.0),
                            section_starts=starts)

    def on_map(self, msg):
        try:
            data = json.loads(msg.data)
        except ValueError as e:
            rospy.logwarn('MowBite Planner: map not readable: %s', e)
            return
        with self.lock:
            changed, self.map = data != self.map, data
            if changed:
                self.armed = None  # (the leftovers were another map's)
        if changed:
            self.plan_ahead_later()

    def plan_ahead_later(self):
        """Every active mowing area planned ahead PLAN_AHEAD_DELAY s from now (from then on, after another change)."""
        with self.ahead_lock:
            if self.ahead is not None:
                self.ahead.cancel()
            self.ahead_count += 1
            self.ahead = threading.Timer(PLAN_AHEAD_DELAY, self.plan_ahead, (self.ahead_count,))
            self.ahead.daemon = True
            self.ahead.start()

    def plan_ahead(self, count=None):
        """Every active mowing area of the map planned like planner.plan would (the app's preview), kept for it. Not
        with planner slic3r (it plans at once, nothing kept). One at a time: after another change (count isn't the
        latest any more) it ends with the area it's at, the next one plans them as they are then."""
        with self.ahead_run:
            if self.current.planner == 'slic3r':
                return
            with self.lock:
                data = self.map
            areas = []
            for area in (data or {}).get('areas', []):
                props = area.get('properties') or {}
                if props.get('type') == 'mow' and props.get('active') is not False and \
                        props.get('mowable') is not False and area.get('id'):
                    areas.append(area)
            t0, done = time.perf_counter(), 0
            for area in areas:
                if count is not None and count != self.ahead_count:
                    return
                if self.ahead_plan(area['id']):
                    done += 1
            if areas:
                rospy.loginfo('MowBite Planner: %d areas planned ahead in %.1f s', done, time.perf_counter() - t0)

    def ahead_plan(self, area_id):
        try:
            got = self.rpc_plan({'area_id': area_id})
            if got.get('duration'):
                rospy.loginfo('MowBite Planner: area %s takes about %.0f min', area_id, got['duration']['min'])
            return True
        except PlanningError as e:
            rospy.logwarn('MowBite Planner: area %s not planned ahead: %s', area_id, e)
        except Exception as e:  # noqa: BLE001 - planning ahead must not take the planner down
            rospy.logerr('MowBite Planner: planning area %s ahead failed: %s: %s', area_id, type(e).__name__, e,
                         exc_info=True)
        return False

    def settings(self, req, job):
        """The node's settings, then what mower_logic asks for, then the area's own (planner property and
        angle range)."""
        current = self.current
        width = max(current.mower_width, req.distance)
        asked = dict(
            mower_width=width,
            # OpenMower's distance is the lane spacing
            overlap=1.0 - req.distance / width,
            perimeter_offset=float(req.outer_offset),
            perimeter_passes=int(req.outline_count),
            lane_overlap_passes=int(req.outline_overlap_count),
            skip_outline_loops=bool(req.skip_area_outline),
            skip_obstacle_loops=bool(req.skip_obstacle_outlines),
            skip_lanes=bool(req.skip_fill),
        )
        # the area's own angle (mower_logic adds mow_angle_offset) beats settings, its planner property beats both
        if not current.own_angle or (job is not None and job.overrides.get('angle') is not None):
            asked['angle'] = float(req.angle)
        if req.fill_type == PlanPathRequest.FILL_CONCENTRIC:
            asked['fill_pattern'] = 'concentric'
        # set here, they beat mower_logic's, but not the area's own (its outline_count, ...)
        for name in current.own:
            asked.pop(name, None)
        if 'overlap' in current.own:  # the blade, not widened to mower_logic's lane spacing
            asked['mower_width'] = current.mower_width
        cfg = current.base.with_overrides(asked)
        if job is not None:
            cfg = cfg.with_overrides({n: v for n, v in job.overrides.items() if n in current.own})
            cfg = cfg.with_overrides(job.planner)
        if cfg.lane_spacing_mode == 'auto':  # the blade, the spacing is the planner's
            cfg = cfg.with_overrides({'mower_width': current.mower_width})
        return cfg.with_overrides({'angle_steps': self.angle['steps'], 'finished_mows': self.angle['finished']})

    def plan_coverage(self, boundary, obstacles, cfg, start=None, end=None, drivable=(), keep_out=(), margins=(),
                      reach_over=()):
        """plan_coverage(), the last CACHED_PLANS kept, in memory and in plans_dir: the plan only depends on what it's
        given and the planner's code, the same again (to the last bit) is the same plan."""
        return self.kept_plan(boundary, obstacles, cfg, start, end, drivable, keep_out, margins, reach_over)[0]

    def kept_plan(self, boundary, obstacles, cfg, start=None, end=None, drivable=(), keep_out=(), margins=(),
                  reach_over=()):
        """(plan, whether it was kept from before), see plan_coverage."""
        if cfg.perimeter_direction != 'random' and cfg.finished_mows:  # (counts only there: the plan kept stays one)
            cfg = cfg.with_overrides({'finished_mows': 0})
        # the obstacles in one order, every way there (the request, the map) gives the same, each with its margin
        margins = list(margins) + [None] * (len(obstacles) + len(keep_out) - len(margins))
        pairs = sorted(zip(canon(obstacles), canon(margins)), key=lambda pair: pair[0])
        obstacles = [o for o, _ in pairs]
        margins = tuple(m for _, m in pairs) + canon(margins[len(obstacles):])
        args = (canon(boundary), obstacles, cfg, canon(start), canon(end), canon(drivable), canon(keep_out), margins)
        reach_over = canon(reach_over)
        key = hashlib.sha1((self.code + repr(args) + (repr(reach_over) if reach_over else '')).encode()).hexdigest()
        with self.plans_lock:
            plan = self.plans.get(key)
            if plan is not None:
                self.plans.move_to_end(key)
                self.local.kept = True
                return plan, True
            busy = self.planning.setdefault(key, threading.Lock())
        with busy:  # (the same asked for meanwhile, planning ahead and a mow: it waits for this one's)
            try:
                with self.plans_lock:
                    plan = self.plans.get(key)
                if plan is None:
                    plan = self.read_plan(key)
                kept = self.local.kept = plan is not None
                if plan is None:
                    plan = plan_coverage(*args, reach_over=reach_over)
                    self.write_plan(key, plan)
                with self.plans_lock:
                    self.plans[key] = plan
                    self.plans.move_to_end(key)
                    while len(self.plans) > CACHED_PLANS:
                        self.plans.popitem(last=False)
            finally:
                with self.plans_lock:
                    self.planning.pop(key, None)
        return plan, kept

    def plan_file(self, key):
        return os.path.join(self.plans_dir, '%s-%s.pkl' % (self.code[:12], key))

    def drop_old_plans(self):
        """The kept plans of another planner code go (and what a write cut off left)."""
        if not self.plans_dir:
            return
        own = self.code[:12] + '-'
        for path in glob.glob(os.path.join(self.plans_dir, '*.pkl')) + glob.glob(os.path.join(self.plans_dir, '*.tmp')):
            if not (path.endswith('.pkl') and os.path.basename(path).startswith(own)):
                try:
                    os.remove(path)
                except OSError:
                    pass

    def read_plan(self, key):
        if not self.plans_dir:
            return None
        try:
            with open(self.plan_file(key), 'rb') as f:
                return pickle.load(f)
        except FileNotFoundError:
            return None
        except Exception as e:  # noqa: BLE001 - a broken or old file is planned again
            rospy.logwarn('MowBite Planner: kept plan %s not readable: %s', key, e)
            return None

    def write_plan(self, key, plan):
        if not self.plans_dir:
            return
        try:
            os.makedirs(self.plans_dir, exist_ok=True)
            path = self.plan_file(key)
            with open(path + '.tmp', 'wb') as f:
                pickle.dump(plan, f, protocol=4)
            os.replace(path + '.tmp', path)
            files = sorted(glob.glob(os.path.join(self.plans_dir, '*.pkl')), key=os.path.getmtime)
            for old in files[:-DISK_PLANS]:
                os.remove(old)
        except (OSError, pickle.PicklingError) as e:
            rospy.logwarn('MowBite Planner: plan not kept in %s: %s', self.plans_dir, e)

    def handle(self, req):
        if self.current.planner == 'slic3r':  # mower_logic's request as it came
            try:
                res = self.classic_answer(req)
                rospy.loginfo('MowBite Planner: %d paths from the slic3r planner (planner slic3r)', len(res.paths))
                return res
            except PlanningError as e:
                rospy.logerr('MowBite Planner: %s, the MowBite Planner plans', e)
        res = PlanPathResponse()
        boundary = [(p.x, p.y) for p in req.outline.points]
        obstacles = [[(p.x, p.y) for p in hole.points] for hole in req.holes]
        with self.lock:
            data = self.map
        index = match_area(data, boundary) if data else None
        job, drivable, keep_out, dock, reach_over = None, [], [], None, []
        try:
            if index is not None:
                job = area_job(data, index)
                # mower_logic sends the map's obstacles (or the ones mowing.plan was given), not these
                obstacles += job.mow_around
                drivable, keep_out, dock, reach_over = job.drivable, job.keep_out, job.dock, job.navigation
            armed = self.armed
            if armed is not None and time.time() > armed['until']:
                armed = self.armed = None
            if armed is not None and job is not None and job.area_id in armed['plans']:
                # planner.leftovers armed: what the mow before left in this area, nothing where it left nothing. The
                # same again while that job runs (mower_logic asks again when it goes on after a break)
                left = armed['plans'][job.area_id]
                if not armed['served']:
                    armed['served'], armed['until'] = True, time.time() + LEFTOVERS_JOB
                stamp = rospy.Time.now()
                for is_outline, first, last in plan_pieces(left, self.max_poses) if left is not None else ():
                    res.paths.append(PlannerPath(is_outline=1 if is_outline else 0,
                                                 path=self.to_path(left.poses[first:last + 1], stamp)))
                rospy.loginfo('MowBite Planner: area %s, the leftovers: %s', job.area_id, 'nothing' if left is None
                              else '%d paths, %.0f m, %d passes' % (len(res.paths), left.stats['path_length'],
                                                                   left.stats['leftovers']['passes']))
                return res
            cfg = self.settings(req, job)
            if job is not None and cfg.nested_areas:
                obstacles += job.nested  # the mowing areas in this one, mowed on their own
            # the map's obstacles (areas to keep out of) with a margin of their own, by their outline
            margins = margins_for(data, obstacles + keep_out)
            # (the end as planner.plan gives it, the heading doesn't count there: planned ahead it's this plan)
            plan, kept = self.kept_plan(boundary, obstacles, cfg, start=dock, end=dock[:2] if dock else None,
                                        drivable=drivable, keep_out=keep_out, margins=margins, reach_over=reach_over)
        except PlanningError as e:
            rospy.logwarn('MowBite Planner: %s', e)
            return res
        except Exception as e:  # noqa: BLE001 - a bad area must not take the planner down
            rospy.logerr('MowBite Planner failed: %s: %s', type(e).__name__, e, exc_info=True)
            return res
        try:
            self.served.append((time.time(), job.area_id if job else None, self.estimate(plan)))
        except Exception as e:  # noqa: BLE001 - the estimate must not keep the plan from mower_logic
            rospy.logwarn('MowBite Planner: no time estimate: %s: %s', type(e).__name__, e, exc_info=True)
        stamp = rospy.Time.now()
        for is_outline, first, last in plan_pieces(plan, self.max_poses):
            res.paths.append(PlannerPath(is_outline=1 if is_outline else 0,
                                         path=self.to_path(plan.poses[first:last + 1], stamp)))
        st = plan.stats
        if not plan.warnings:
            warnings = ''
        elif self.warned.get(id(plan)) is plan:
            warnings = ', %d warnings as before' % len(plan.warnings)
        else:
            warnings = '. ' + '; '.join(plan.warnings)
            self.warned[id(plan)] = plan
        rospy.loginfo('MowBite Planner: %s%d paths, %d poses, %.0f m, lanes at %.1f deg, %s%s',
                      'area %s, ' % job.area_id if job else '', len(res.paths), len(plan.poses),
                      st['path_length'], math.degrees(plan.angle),
                      'kept from before' if kept else '%.0f ms' % (1000 * st['planning_time']), warnings)
        return res

    def to_path(self, poses, stamp):
        header = Header(frame_id=self.frame_id, stamp=stamp)
        path = Path(header=header)
        for p in poses:
            x, y, z, w = yaw_to_quaternion(p.yaw)
            path.poses.append(PoseStamped(header=header, pose=Pose(position=Point(x=p.x, y=p.y, z=0.0),
                                                                   orientation=Quaternion(x=x, y=y, z=z, w=w))))
        return path


def canon(value):
    """Points, lists of them and so on as tuples of floats: the same whichever way they came."""
    if isinstance(value, (list, tuple)):
        return tuple(canon(v) for v in value)
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    return value


def code_version():
    """A digest of the planner's code: a plan kept on disk counts for that code only. (Built with catkin, the package
    first found is a stand-in that only points to the code, its __path__ has both.)"""
    digest = hashlib.sha1()
    for root in mowbite_planner.__path__:
        for name in sorted(os.listdir(root)):
            if name.endswith('.py'):
                with open(os.path.join(root, name), 'rb') as f:
                    digest.update(name.encode() + b'\0' + f.read())
    return digest.hexdigest()


def read_track(path):
    """The driven points of a position_history file (OpenMower's: new_segment and append_points lines of [x, y]),
    each facing the next one (DRIVE_STEP apart at least, the last one as the one before), with whether the blade ran
    there (its new_segment's blades): [(Pose2D, blade), ...]."""
    pts, blade = [], False
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            if rec.get('type') == 'new_segment':
                blade = bool((rec.get('attributes') or {}).get('blades'))
            for xy in rec.get('points') or []:
                if isinstance(xy, (list, tuple)) and len(xy) >= 2 and (
                        not pts or math.hypot(xy[0] - pts[-1][0], xy[1] - pts[-1][1]) >= DRIVE_STEP):
                    pts.append((float(xy[0]), float(xy[1]), blade))
    out = [(Pose2D(x, y, math.atan2(b[1] - y, b[0] - x)), on) for (x, y, on), b in zip(pts, pts[1:])]
    return out + [(Pose2D(pts[-1][0], pts[-1][1], out[-1][0].yaw), pts[-1][2])] if out else []


def read_runs(path):
    """The segments of a position_history file: [(whether the blade ran, its driven points [(x, y), ...]), ...]."""
    runs = []
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            if rec.get('type') == 'new_segment':
                runs.append((bool((rec.get('attributes') or {}).get('blades')), []))
            for xy in rec.get('points') or []:
                if runs and isinstance(xy, (list, tuple)) and len(xy) >= 2:
                    runs[-1][1].append((float(xy[0]), float(xy[1])))
    return runs


def mowing_time(path):
    """s from the blade starting to run to it stopping last in a position_history file (its new_segment lines with
    started_at and blades), the runs between added up; None without a run that ended."""
    segments = []
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict) and rec.get('type') == 'new_segment' and \
                    isinstance(rec.get('started_at'), (int, float)):
                segments.append((float(rec['started_at']), bool((rec.get('attributes') or {}).get('blades'))))
    runs = [b - a for (a, blades), (b, _) in zip(segments, segments[1:]) if blades]
    return sum(runs) if runs else None


def master_restarted(run_id):
    """Whether the master now has another /run_id than run_id. While it's down: no (the new one comes later)."""
    try:
        return rospy.get_param('/run_id', run_id) != run_id
    except OSError:
        return False


def main():
    rospy.init_node('slic3r_coverage_planner')
    MowbitePlannerRos1()
    run_id = rospy.get_param('/run_id', None)
    while not rospy.is_shutdown():
        time.sleep(MASTER_CHECK)
        if run_id is not None and master_restarted(run_id):
            rospy.logwarn('MowBite Planner: the ROS master restarted, ending to register again')
            rospy.signal_shutdown('ROS master restarted')
            raise SystemExit(1)


if __name__ == '__main__':
    main()
