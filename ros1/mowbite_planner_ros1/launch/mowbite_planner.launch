<!-- The MowBite Planner in place of OpenMower's slic3r planner: the same service name
     (/slic3r_coverage_planner/plan_path), so mower_logic and the mowing.plan RPC use it as they are.
     Start it instead of the slic3r_coverage_planner node, not next to it. -->
<launch>
  <node pkg="mowbite_planner_ros1" type="mowbite_planner_node" name="slic3r_coverage_planner" output="screen"
        respawn="true" respawn_delay="10">
    <!-- the blade's cutting width [m] (OM_BLADE_WIDTH). OpenMower's tool_width is the lane spacing, usually smaller -->
    <param name="mower_width" value="$(optenv OM_BLADE_WIDTH 0.18)"/>
    <!-- any MowBite Planner setting for all areas (an area's own go in its "planner" property in the map).
         Without, it plans for OpenMower's forward only FTC controller: allow_reverse false, lane_order skip.
         Lane spacing, loops and skip flags come with mower_logic's request, the angle too unless angle or
         angle_strategy is set here and the area has no angle of its own in the saved map (an editor preview
         of an angle just added or removed follows the saved area until the edit is saved). The edges are walls
         until set otherwise (edges: recorded where the lines were driven with the mower's centre on them) -->
    <rosparam param="settings">{turn_radius: 0.25, narrow_parts: loops, edges: hard}</rosparam>
    <!-- the settings changed with the planner.settings.set RPC, on top of the ones above. Empty: until the next start -->
    <param name="settings_file" value="$(optenv ROS_HOME ~/.ros)/mowbite_planner_settings.json"/>
  </node>
</launch>
