<!-- The MowBite Planner in place of OpenMower's slic3r planner: the same service name
     (/slic3r_coverage_planner/plan_path), so mower_logic and the mowing.plan RPC use it as they are.
     Start it instead of the slic3r_coverage_planner node, not next to it (slic3r comes as slic3r_classic). -->
<launch>
  <!-- own_container: in a container of its own (OM_PLANNER=external), where everything ends when the node does (the
       ROS master restarted) and the container comes back (its restart policy), the slic3r planner registered again -->
  <arg name="own_container" default="false"/>
  <node pkg="mowbite_planner_ros1" type="mowbite_planner_node" name="slic3r_coverage_planner" output="screen"
        respawn="$(eval not own_container)" required="$(arg own_container)" respawn_delay="10">
    <!-- the blade's cutting width [m] (OM_BLADE_WIDTH). OpenMower's tool_width is the lane spacing, usually smaller -->
    <param name="mower_width" value="$(optenv OM_BLADE_WIDTH 0.18)"/>
    <!-- any MowBite Planner setting for all areas (an area's own go in its "planner" property in the map).
         Without, it plans for OpenMower's forward only FTC controller: lane_order skip.
         Lane spacing, loops and skip flags come with mower_logic's request, the angle too unless angle or
         angle_strategy is set here and the area has no angle of its own in the saved map (an editor preview
         of an angle just added or removed follows the saved area until the edit is saved). The lines of the map are
         where the mower's centre drove recording them until set otherwise (edges: hard, walls: lines drawn on the
         real edge, the body kept inside them), the planner works out the lane spacing until it's set to fixed -->
    <rosparam param="settings">{turn_radius: 0.25, narrow_parts: loops, edges: recorded, lane_spacing_mode: auto}</rosparam>
    <!-- the settings changed with the planner.settings.set RPC, on top of the ones above. Empty: until the next start -->
    <param name="settings_file" value="$(optenv ROS_HOME ~/.ros)/mowbite_planner_settings.json"/>
    <!-- the settings page with a preview of the plans: http://<mower>:<port>/ (MOWBITE_WEB_PORT, 0: none) -->
    <param name="web_port" value="$(optenv MOWBITE_WEB_PORT 8090)"/>
    <!-- processes of their own that plan (MOWBITE_WORKERS, 0: all in the node's): the CM4 has 4 cores -->
    <param name="workers" value="$(optenv MOWBITE_WORKERS 3)"/>
  </node>
  <!-- OpenMower's slic3r planner for the setting planner slic3r: the MowBite Planner hands it mower_logic's request -->
  <node pkg="slic3r_coverage_planner" type="slic3r_coverage_planner" name="slic3r_classic" output="screen"
        respawn="true" respawn_delay="10">
    <remap from="slic3r_coverage_planner/plan_path" to="slic3r_classic/plan_path"/>
  </node>
</launch>
